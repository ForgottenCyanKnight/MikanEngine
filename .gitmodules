[submodule "JoltPhysics"]
	path = dependencies/JoltPhysics
	url = https://github.com/jrouwe/JoltPhysics.git
[submodule "glm"]
	path = dependencies/glm
	url = https://github.com/g-truc/glm.git
[submodule "box2d"]
	path = dependencies/box2d
	url = https://github.com/erincatto/box2d.git
[submodule "FastNoiseLite"]
	path = dependencies/FastNoiseLite
	url = https://github.com/Auburn/FastNoiseLite.git
[submodule "Vulkan-Headers"]
	path = dependencies/vulkan
	url = https://github.com/KhronosGroup/Vulkan-Headers.git
[submodule "SDL"]
	path = dependencies/SDL3
	url = https://github.com/libsdl-org/SDL.git
[submodule "SDL_image"]
	path = dependencies/SDL3_image
	url = https://github.com/libsdl-org/SDL_image.git
[submodule "NRD"]
	path = dependencies/NRD
	url = https://github.com/NVIDIA-RTX/NRD.git
