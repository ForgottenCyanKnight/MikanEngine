set(project_dir [==[@project_dir@]==])
set(engine_dir [==[@CMAKE_SOURCE_DIR@/engine]==])
set(manifest_path "${project_dir}/project.json")
get_filename_component(bundle_dir "$ENV{DESTDIR}${CMAKE_INSTALL_PREFIX}" REALPATH)
cmake_path(IS_PREFIX project_dir "${bundle_dir}" NORMALIZE bundle_in_project)
cmake_path(IS_PREFIX engine_dir "${bundle_dir}" NORMALIZE bundle_in_engine_assets)
get_filename_component(project_destination "${bundle_dir}/projects/game" REALPATH)
cmake_path(IS_PREFIX project_dir "${project_destination}" NORMALIZE project_destination_in_source)
if(bundle_in_project OR bundle_in_engine_assets OR project_destination_in_source
   OR bundle_dir STREQUAL [==[@CMAKE_SOURCE_DIR@]==])
    message(FATAL_ERROR "Choose an install prefix outside the selected project and engine assets: ${bundle_dir}")
endif()
if(NOT EXISTS "${engine_dir}/shaders/spv/shader-build-plan.txt")
    message(FATAL_ERROR "Build MikanEngine before installing the project bundle")
endif()

file(READ "${manifest_path}" manifest)
string(JSON asset_type ERROR_VARIABLE asset_error TYPE "${manifest}" assets)
if(NOT asset_error AND NOT asset_type STREQUAL "ARRAY")
    message(FATAL_ERROR "Project manifest assets must be an array: ${manifest_path}")
endif()
if(asset_type STREQUAL "ARRAY")
    string(JSON asset_count LENGTH "${manifest}" assets)
    math(EXPR last_asset "${asset_count} - 1")
    if(last_asset GREATER_EQUAL 0)
        foreach(index RANGE ${last_asset})
            string(JSON asset GET "${manifest}" assets ${index})
            if(IS_ABSOLUTE "${asset}" OR asset MATCHES "^[A-Za-z]:|^\\\\|^\\.\\.([/\\\\]|$)")
                message(FATAL_ERROR "Copy linked asset into the project and update project.json before packaging: ${asset}")
            endif()
        endforeach()
    endif()
endif()

file(GLOB_RECURSE project_files LIST_DIRECTORIES TRUE "${project_dir}/*")
set(code_dir "${project_dir}/@code_root@")
set(real_code_dir [==[@code_dir@]==])
foreach(path IN LISTS project_files)
    if(IS_SYMLINK "${path}" AND NOT path MATCHES "(^|/)\\.git(/|$)")
        cmake_path(IS_PREFIX code_dir "${path}" NORMALIZE in_code_root)
        if(in_code_root)
            continue()
        endif()
        file(READ_SYMLINK "${path}" link)
        get_filename_component(link_target "${path}" REALPATH)
        cmake_path(IS_PREFIX project_dir "${link_target}" NORMALIZE link_in_project)
        cmake_path(IS_PREFIX real_code_dir "${link_target}" NORMALIZE link_in_code_root)
        if(IS_ABSOLUTE "${link}" OR NOT EXISTS "${path}" OR NOT link_in_project OR link_in_code_root
           OR link_target MATCHES "(^|/)\\.git(/|$)")
            message(FATAL_ERROR "Package asset symlink must reference another packaged project file: ${path} -> ${link}")
        endif()
    endif()
endforeach()
