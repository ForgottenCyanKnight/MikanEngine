set(MIKAN_PROJECT_PATH "" CACHE PATH "Project directory to build and package with the Linux runtime")
if(NOT MIKAN_PROJECT_PATH)
    return()
endif()
if(CMAKE_VERSION VERSION_LESS 3.21)
    message(FATAL_ERROR "MIKAN_PROJECT_PATH requires CMake 3.21 or newer")
endif()

get_filename_component(project_dir "${MIKAN_PROJECT_PATH}" REALPATH BASE_DIR "${CMAKE_SOURCE_DIR}")
set(project_manifest "${project_dir}/project.json")
if(NOT EXISTS "${project_manifest}")
    message(FATAL_ERROR "Project manifest not found: ${project_manifest}")
endif()
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${project_manifest}")
file(READ "${project_manifest}" manifest)
string(JSON manifest_type TYPE "${manifest}")
if(NOT manifest_type STREQUAL "OBJECT")
    message(FATAL_ERROR "Project manifest must be a JSON object: ${project_manifest}")
endif()

function(mikan_project_string key default result)
    string(JSON value_type ERROR_VARIABLE missing TYPE "${manifest}" "${key}")
    if(missing)
        set(${result} "${default}" PARENT_SCOPE)
    elseif(value_type STREQUAL "STRING")
        string(JSON value GET "${manifest}" "${key}")
        set(${result} "${value}" PARENT_SCOPE)
    else()
        message(FATAL_ERROR "Project manifest ${key} must be a string: ${project_manifest}")
    endif()
endfunction()

mikan_project_string(game "" game)
mikan_project_string(codeRoot "games" code_root)
mikan_project_string(runtimeProfile "full" runtime_profile)
if(NOT runtime_profile MATCHES "^(full|2d)$")
    message(FATAL_ERROR "Unknown runtimeProfile in ${project_manifest}: ${runtime_profile}")
endif()
if(IS_ABSOLUTE "${code_root}" OR code_root MATCHES "^[A-Za-z]:|^\\\\")
    message(FATAL_ERROR "Project codeRoot must be relative: ${code_root}")
endif()
cmake_path(NORMAL_PATH code_root)
if(NOT code_root OR code_root STREQUAL ".")
    set(code_root "games")
endif()
get_filename_component(code_dir "${project_dir}/${code_root}" REALPATH)
cmake_path(IS_PREFIX project_dir "${code_dir}" NORMALIZE code_in_project)
if(NOT code_in_project OR code_dir STREQUAL project_dir)
    message(FATAL_ERROR "Project codeRoot must stay inside the project: ${code_root}")
endif()

if(NOT game STREQUAL "")
    if(NOT game MATCHES "^[A-Za-z0-9_.-]+$" OR game STREQUAL "." OR game STREQUAL "..")
        message(FATAL_ERROR "Invalid game module name in ${project_manifest}: ${game}")
    endif()
    get_filename_component(game_dir "${code_dir}/${game}" REALPATH)
    cmake_path(IS_PREFIX code_dir "${game_dir}" NORMALIZE game_in_code_root)
    if(NOT game_in_code_root OR game_dir STREQUAL code_dir)
        message(FATAL_ERROR "Gameplay module source must stay inside codeRoot: ${game_dir}")
    endif()
    file(GLOB game_sources LIST_DIRECTORIES FALSE CONFIGURE_DEPENDS "${game_dir}/*.cpp")
    if(NOT game_sources)
        message(FATAL_ERROR "No gameplay module sources found in ${game_dir}")
    endif()
    add_library(MikanProjectGame MODULE ${game_sources})
    set_target_properties(MikanProjectGame PROPERTIES OUTPUT_NAME "Game${game}"
        BUILD_RPATH_USE_ORIGIN ON INSTALL_RPATH "$ORIGIN")
    target_include_directories(MikanProjectGame PRIVATE
        $<TARGET_PROPERTY:Game,INCLUDE_DIRECTORIES> include/UI include/World include/Game include/Platform)
    target_compile_definitions(MikanProjectGame PRIVATE MIKAN_USE_GAME ${JOLT_COMPILE_DEFINITIONS})
    # GNU-unique statics would keep the module loaded after dlclose.
    target_compile_options(MikanProjectGame PRIVATE $<$<CXX_COMPILER_ID:GNU>:-fno-gnu-unique>)
    target_link_libraries(MikanProjectGame PRIVATE Game MikanVulkanLoader)
    target_link_options(MikanProjectGame PRIVATE "LINKER:--no-undefined")
    add_dependencies(MikanEngine MikanProjectGame)
    add_dependencies(MikanTestRunner MikanProjectGame)
endif()

set_target_properties(MikanEngine PROPERTIES BUILD_RPATH_USE_ORIGIN ON INSTALL_RPATH "$ORIGIN")

configure_file("${CMAKE_CURRENT_LIST_DIR}/ValidateLinuxProjectInstall.cmake.in"
    "${CMAKE_CURRENT_BINARY_DIR}/ValidateLinuxProjectInstall.cmake" @ONLY)
install(SCRIPT "${CMAKE_CURRENT_BINARY_DIR}/ValidateLinuxProjectInstall.cmake" COMPONENT MikanProject)
install(TARGETS MikanEngine Game RUNTIME DESTINATION . COMPONENT MikanProject
    LIBRARY DESTINATION . COMPONENT MikanProject)
if(TARGET MikanProjectGame)
    install(TARGETS MikanProjectGame LIBRARY DESTINATION . COMPONENT MikanProject)
endif()
install(PROGRAMS "${CMAKE_CURRENT_LIST_DIR}/LinuxProjectLauncher.sh" DESTINATION .
    RENAME run.sh COMPONENT MikanProject)
if(runtime_profile STREQUAL "2d")
    set(engine_dir "${CMAKE_SOURCE_DIR}/engine")
    set(asset_list "${engine_dir}/runtime_2d_assets.list")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${asset_list}")
    file(STRINGS "${asset_list}" runtime_assets)
    string(JSON asset_count ERROR_VARIABLE no_assets LENGTH "${manifest}" assets)
    if(NOT no_assets AND asset_count GREATER 0)
        math(EXPR last_asset "${asset_count} - 1")
        foreach(index RANGE ${last_asset})
            string(JSON asset GET "${manifest}" assets ${index})
            if(asset MATCHES "^engine/(.+)$")
                list(APPEND runtime_assets "${CMAKE_MATCH_1}")
            endif()
        endforeach()
    endif()
    list(REMOVE_DUPLICATES runtime_assets)
    install(FILES "${asset_list}" DESTINATION engine COMPONENT MikanProject)
    foreach(asset IN LISTS runtime_assets)
        string(STRIP "${asset}" asset)
        if(asset STREQUAL "" OR asset MATCHES "^#")
            continue()
        endif()
        set(source "${engine_dir}/${asset}")
        cmake_path(NORMAL_PATH source)
        cmake_path(IS_PREFIX engine_dir "${source}" NORMALIZE inside_engine)
        if(NOT inside_engine OR source STREQUAL engine_dir OR IS_ABSOLUTE "${asset}")
            message(FATAL_ERROR "2D runtime asset must be inside engine/: ${asset}")
        endif()
        cmake_path(RELATIVE_PATH source BASE_DIRECTORY "${engine_dir}" OUTPUT_VARIABLE relative_source)
        cmake_path(GET relative_source PARENT_PATH folder)
        if(IS_DIRECTORY "${source}")
            install(DIRECTORY "${source}" DESTINATION "engine/${folder}" COMPONENT MikanProject)
        else()
            install(FILES "${source}" DESTINATION "engine/${folder}" COMPONENT MikanProject)
        endif()
    endforeach()
else()
    install(DIRECTORY "${CMAKE_SOURCE_DIR}/engine/" DESTINATION engine COMPONENT MikanProject
        PATTERN ".compile-shaders-*" EXCLUDE PATTERN ".shaderhotreload-*" EXCLUDE)
endif()

# Match the exact source subtree, including a nested custom codeRoot.
string(REGEX REPLACE "([][+.*()^$?|\\\\])" "\\\\\\1" code_pattern "${project_dir}/${code_root}")
string(REGEX REPLACE "([][+.*()^$?|\\\\])" "\\\\\\1" code_real_pattern "${code_dir}")
install(DIRECTORY "${project_dir}/" DESTINATION projects/game COMPONENT MikanProject
    REGEX "^(${code_pattern}|${code_real_pattern})(/|$)" EXCLUDE PATTERN ".git" EXCLUDE)
install(FILES "${CMAKE_SOURCE_DIR}/LICENSE" "${CMAKE_SOURCE_DIR}/THIRD_PARTY_NOTICES.md"
    DESTINATION . COMPONENT MikanProject)

# Preserve retained notices for the dependencies incorporated by the runtime.
set(license_dir "${CMAKE_SOURCE_DIR}/dependencies")
file(READ "${license_dir}/license-manifest.json" licenses)
string(JSON license_count LENGTH "${licenses}" files)
math(EXPR last_license "${license_count} - 1")
foreach(index RANGE ${last_license})
    string(JSON component GET "${licenses}" files ${index} component)
    if(component MATCHES "^(imgui|JoltPhysics|msdfgen|SDL3|SDL3_image|meshoptimizer|zlib|tinyxml2|stb|json|vma|vulkan|Saba|Box2D|GLM|miniaudio|FastNoiseLite|assimp-headers|Falcor|STBN)$"
       OR (MIKAN_ENABLE_NRD AND component MATCHES "^(NRD|ShaderMake|MathLib)$"))
        string(JSON path GET "${licenses}" files ${index} path)
        get_filename_component(subdir "${path}" DIRECTORY)
        install(FILES "${license_dir}/${path}" DESTINATION "dependencies/${subdir}" COMPONENT MikanProject)
    endif()
endforeach()
