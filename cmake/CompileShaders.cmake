# Used by the desktop build and by tools/compile_shaders.ps1 in script mode.
function(mikan_add_shader output target)
    get_filename_component(name "${output}" NAME)
    if(name IN_LIST shader_names)
        message(FATAL_ERROR "Duplicate SPIR-V file name: ${name} (${output})")
    endif()
    set(output_path "${spv_dir}/${output}")
    get_filename_component(output_dir "${output_path}" DIRECTORY)
    string(JOIN " " defines ${ARGN})
    set(shader_names "${shader_names};${name}" PARENT_SCOPE)
    set(shader_outputs "${shader_outputs};${output_path}" PARENT_SCOPE)
    string(APPEND shader_plan "${output}\t${source}\t${target}\t${defines}\n")
    set(shader_plan "${shader_plan}" PARENT_SCOPE)

    if(CMAKE_SCRIPT_MODE_FILE)
        file(MAKE_DIRECTORY "${output_dir}")
        execute_process(
            COMMAND "${validator}" -V --target-env "${target}" ${ARGN} "${glsl_dir}/${source}" -o "${output_path}"
            RESULT_VARIABLE result)
        if(NOT result STREQUAL "0" OR NOT EXISTS "${output_path}")
            message(FATAL_ERROR "Shader compilation failed: ${source} -> ${output} (${result})")
        endif()
    else()
        add_custom_command(OUTPUT "${output_path}"
            COMMAND "${CMAKE_COMMAND}" -E make_directory "${output_dir}"
            COMMAND "${validator}" -V --target-env "${target}" ${ARGN} "${glsl_dir}/${source}" -o "${output_path}"
            DEPENDS "${glsl_dir}/${source}" ${shader_includes}
            COMMENT "Compiling shader: ${output}"
            VERBATIM)
    endif()
endfunction()

function(mikan_compile_shaders glsl_dir spv_dir validator)
    set(glob_options RELATIVE "${glsl_dir}")
    if(NOT CMAKE_SCRIPT_MODE_FILE)
        list(APPEND glob_options CONFIGURE_DEPENDS)
        # Track shared and transitive includes, including those used only by variants.
        file(GLOB_RECURSE shader_includes CONFIGURE_DEPENDS "${glsl_dir}/*.glsl" "${glsl_dir}/*.h")
    endif()
    file(GLOB_RECURSE sources ${glob_options} "${glsl_dir}/*.vert" "${glsl_dir}/*.frag" "${glsl_dir}/*.comp")
    if(NOT sources)
        message(FATAL_ERROR "No GLSL shader sources found: ${glsl_dir}")
    endif()

    set(shader_names)
    set(shader_outputs)
    set(shader_plan "")
    foreach(source IN LISTS sources)
        get_filename_component(filename "${source}" NAME)
        get_filename_component(category "${source}" DIRECTORY)
        set(target spirv1.3)
        if(filename MATCHES "^(vox_rt_validate|vox_rt_realtime|dlss_rr_prepare)\\.comp$")
            set(target vulkan1.2)
        endif()
        set(output "${source}.spv")
        mikan_add_shader("${output}" "${target}")

        if(filename MATCHES "^visibility_buffer\\.(vert|frag)$")
            mikan_add_shader("${source}.strip.spv" vulkan1.2 -DMIKAN_VISIBILITY_STRIP=1)
        endif()
        if(filename STREQUAL "vox_rt_realtime.comp")
            mikan_add_shader("raytracing/visibility/visibility_dda.comp.spv" vulkan1.2 -DMIKAN_VISIBILITY_TRACE_ONLY=1)
            set(native_flags -DMIKAN_RT_HAS_LOD=0 -DMIKAN_RT_HAS_TRIANGLE_DEBUG=0 -DMIKAN_RT_HAS_CUSTOM_TRAVERSAL=0)
            mikan_add_shader("${category}/vox_rt_realtime.comp.native.spv" vulkan1.2 ${native_flags})
            mikan_add_shader("${category}/vox_rt_realtime.comp.native_full.spv" vulkan1.2 ${native_flags} -DMIKAN_RT_HAS_HALF_LIGHTING=0)
            mikan_add_shader("${category}/vox_rt_realtime.comp.brick.spv" vulkan1.2 -DMIKAN_RT_BRICK_ONLY=1 -DMIKAN_RT_HAS_LOD=0)
            mikan_add_shader("${category}/vox_rt_enhanced.comp.spv" vulkan1.2 -DMIKAN_ENHANCED_PT=1)
        endif()
        if(filename MATCHES "^(model|pmx|voxel_mesh|terrain|grass|world|cloth|particle|sph_container)\\.frag$")
            mikan_add_shader("${output}.triangle_debug.spv" "${target}" -DMIKAN_TRIANGLE_DEBUG=1)
        endif()
        if(filename STREQUAL "tonemap.frag")
            mikan_add_shader("${output}.triangle_debug_display.spv" "${target}" -DMIKAN_TRIANGLE_DEBUG_DISPLAY=1)
        endif()
        if(filename STREQUAL "fullscreen.frag")
            mikan_add_shader("${category}/fullscreen_subpass.frag.spv" "${target}" -DMIKAN_SUBPASS_LOAD)
        endif()
        if(filename MATCHES "^(bloom_(down|up)2x)\\.frag$")
            set(bloom "${CMAKE_MATCH_1}")
            mikan_add_shader("${category}/${bloom}_dual.frag.spv" "${target}" -DBLOOM_KERNEL_DUAL)
            mikan_add_shader("${category}/${bloom}_gauss5.frag.spv" "${target}" -DBLOOM_KERNEL_GAUSS5)
        endif()
    endforeach()

    set(plan_output "${spv_dir}/shader-build-plan.txt")
    if(CMAKE_SCRIPT_MODE_FILE)
        file(WRITE "${plan_output}" "${shader_plan}")
    else()
        set(plan_input "${CMAKE_CURRENT_BINARY_DIR}/shader-build-plan.txt")
        file(GENERATE OUTPUT "${plan_input}" CONTENT "${shader_plan}")
        add_custom_command(OUTPUT "${plan_output}"
            COMMAND "${CMAKE_COMMAND}" -E copy "${plan_input}" "${plan_output}"
            DEPENDS "${plan_input}" ${shader_outputs}
            VERBATIM)
        add_custom_target(CompileShaders DEPENDS "${plan_output}")
    endif()
endfunction()

if(CMAKE_SCRIPT_MODE_FILE)
    cmake_minimum_required(VERSION 3.16)
    mikan_compile_shaders("${GLSL_DIR}" "${SPV_DIR}" "${GLSLANG_VALIDATOR}")
endif()
