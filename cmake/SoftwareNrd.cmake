# Use the same NRD SDK encodings and SPIR-V settings as the production renderer.
set(NRD_STATIC_LIBRARY ON CACHE BOOL "" FORCE)
set(NRD_NRI OFF CACHE BOOL "" FORCE)
set(NRD_EMBEDS_SPIRV_SHADERS ON CACHE BOOL "" FORCE)
set(NRD_EMBEDS_DXIL_SHADERS OFF CACHE BOOL "" FORCE)
set(NRD_EMBEDS_DXBC_SHADERS OFF CACHE BOOL "" FORCE)
set(NRD_SUPPORTS_QUAD_INTRINSICS OFF CACHE BOOL "" FORCE)
set(NRD_NORMAL_ENCODING "4" CACHE STRING "" FORCE)
set(NRD_ROUGHNESS_ENCODING "1" CACHE STRING "" FORCE)
set(NRD_SHADERS_PATH "${CMAKE_CURRENT_BINARY_DIR}/nrd-shaders" CACHE STRING "" FORCE)
set(NRD_SHADER_JOBS "2" CACHE STRING "" FORCE)
add_subdirectory("${PROJECT_SOURCE_DIR}/dependencies/NRD" "${CMAKE_CURRENT_BINARY_DIR}/nrd")
target_sources(MikanVoxCompletePreview PRIVATE src/Rendering/Denoising/NrdDiffuseDenoiser.cpp src/Rendering/Denoising/DiffuseDenoiser.cpp)
target_compile_definitions(MikanVoxCompletePreview PRIVATE MIKAN_ENABLE_NRD=1 MIKAN_PREVIEW_NRD=1)
target_link_libraries(MikanVoxCompletePreview PRIVATE NRD)
