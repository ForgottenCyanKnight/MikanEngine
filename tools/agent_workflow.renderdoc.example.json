{
  "schemaVersion": 1,
  "name": "baka3d-renderdoc-capture",
  "description": "验证场景后构建 EngineMain，并用桌面 RenderDoc 抓取第 60 个 Present。",
  "allowDestructive": false,
  "defaults": {
    "timeoutSeconds": 300
  },
  "steps": [
    {
      "id": "validate_scene",
      "action": "validate_scene",
      "args": {
        "scenePath": "assets/baka3d.json",
        "checkAssets": true
      }
    },
    {
      "id": "build_engine",
      "action": "build",
      "dependsOn": ["validate_scene"],
      "args": {
        "target": "EngineMain",
        "configureIfMissing": true,
        "killEngine": true
      }
    },
    {
      "id": "capture_frame",
      "action": "capture_frame",
      "dependsOn": ["build_engine"],
      "args": {
        "scene": "assets/baka3d.json",
        "game": "baka3d",
        "captureFrame": 60,
        "frames": 90,
        "fixedDeltaSeconds": 0.016666667,
        "captureWaitSeconds": 10
      }
    }
  ]
}
