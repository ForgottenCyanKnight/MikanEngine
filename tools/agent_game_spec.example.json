{
  "schemaVersion": 1,
  "name": "contact2d-ai-native-demo",
  "description": "用结构化 GameSpec 在已有素材和场景上生成一个可回滚的场景变体，并完成玩法 smoke、状态断言和交付打包。",
  "goal": "在 Contact2D 场景中增加一个 AgentMarker，运行固定时间步玩法测试，并输出可回放的场景、测试证据和交付包。",
  "mode": "preview",
  "allowDestructive": false,
  "project": {
    "scenePath": "assets/contact2d.json",
    "game": "contact2d"
  },
  "assets": {
    "requiredPaths": [
      "assets/contact2d.json"
    ],
    "queries": [
      {
        "query": "contact2d",
        "assetType": "scenes",
        "required": true,
        "maxResults": 20
      }
    ]
  },
  "scene": {
    "commandsPath": "tools/scene_command.example.json",
    "checkAssets": true
  },
  "scripts": [],
  "tests": {
    "gameplay": {
      "enabled": true,
      "frames": 60,
      "fixedDeltaSeconds": 0.016666667,
      "timeoutMs": 60000
    },
    "assertions": [
      {
        "entityName": "Bg",
        "field": "pos",
        "expected": [-1500, -1000, 0],
        "tolerance": 0.001
      }
    ],
    "render": {
      "enabled": false
    },
    "capture": {
      "enabled": false
    },
    "performance": {
      "enabled": false
    }
  },
  "delivery": {
    "enabled": true,
    "packageZip": true,
    "includeBuildArtifacts": false,
    "includeCaptures": false
  }
}
