{
  "schemaVersion": 1,
  "name": "contact2d-agent-smoke",
  "description": "验证场景、构建插件、运行 CPU-only 玩法测试并对静态背景做状态断言。",
  "allowDestructive": false,
  "defaults": {
    "timeoutSeconds": 600
  },
  "steps": [
    {
      "id": "validate_scene",
      "action": "validate_scene",
      "args": {
        "projectPath": "projects/engine-samples",
        "scenePath": "scenes/contact2d.json",
        "checkAssets": true
      }
    },
    {
      "id": "build_runner",
      "action": "build",
      "dependsOn": ["validate_scene"],
      "args": {
        "target": "MikanTestRunner",
        "configureIfMissing": true
      }
    },
    {
      "id": "compile_games",
      "action": "compile_games",
      "dependsOn": ["build_runner"],
      "args": {
        "projectPath": "projects/engine-samples"
      }
    },
    {
      "id": "gameplay",
      "action": "run_gameplay_test",
      "dependsOn": ["compile_games"],
      "args": {
        "projectPath": "projects/engine-samples",
        "scene": "scenes/contact2d.json",
        "game": "contact2d",
        "frames": 60,
        "fixedDeltaSeconds": 0.016666667,
        "timeoutMs": 60000
      }
    },
    {
      "id": "read_state",
      "action": "read_dump",
      "dependsOn": ["gameplay"],
      "args": {
        "path": "${steps.gameplay.result.dumpPath}"
      }
    },
    {
      "id": "assert_static_background",
      "action": "assert_state",
      "dependsOn": ["read_state"],
      "args": {
        "path": "${steps.gameplay.result.dumpPath}",
        "assertions": [
          {
            "entityName": "Bg",
            "field": "pos",
            "expected": [-1500, -1000, 0],
            "tolerance": 0.001
          }
        ]
      }
    }
  ]
}
