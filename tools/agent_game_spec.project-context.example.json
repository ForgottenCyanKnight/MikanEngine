{
  "schemaVersion": 1,
  "name": "third-person-combat-context-demo",
  "description": "使用已有项目上下文生成受控测试与交付计划的模板。",
  "goal": "读取第三人称项目的 manifest 和资源根，验证场景可以被项目化运行时正确加载。",
  "mode": "preview",
  "allowDestructive": false,
  "project": {
    "projectPath": "projects/third-person-combat",
    "scenePath": "scenes/main.json",
    "game": "cesiumwalk"
  },
  "assets": {
    "requiredPaths": [
      "projects/third-person-combat/scenes/main.json"
    ],
    "queries": [
      {
        "query": "Lantern",
        "assetType": "models",
        "required": true,
        "maxResults": 20
      }
    ]
  },
  "scripts": [],
  "tests": {
    "gameplay": {
      "enabled": true,
      "frames": 120,
      "fixedDeltaSeconds": 0.016666667,
      "timeoutMs": 120000
    },
    "assertions": [],
    "render": {
      "enabled": false
    },
    "capture": {
      "enabled": false
    },
    "performance": {
      "enabled": false
    }
  },
  "delivery": {
    "enabled": true,
    "packageZip": true,
    "includeBuildArtifacts": false,
    "includeCaptures": false
  }
}
