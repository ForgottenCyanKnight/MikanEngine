{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mikanengine://tools/agent_game_spec.schema.json",
  "title": "MikanEngine AI Native GameSpec",
  "description": "模型输出的受控游戏构建规格：项目、素材、场景命令、玩法脚本、测试门禁和交付选项。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "name", "goal", "project", "tests", "delivery"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "name": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,159}$" },
    "description": { "type": "string", "maxLength": 2000 },
    "goal": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "mode": { "type": "string", "enum": ["preview", "execute"], "default": "preview" },
    "allowDestructive": { "type": "boolean", "default": false },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scenePath"],
      "properties": {
        "projectPath": { "type": "string", "description": "可选；项目目录，scenePath 可写项目相对路径，例如 projects/third-person-combat + scenes/main.json" },
        "scenePath": { "type": "string", "minLength": 1 },
        "game": { "type": "string", "maxLength": 128 },
        "engineBuild": { "type": "boolean", "default": false }
      }
    },
    "assets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requiredPaths": {
          "type": "array",
          "maxItems": 128,
          "items": { "type": "string", "minLength": 1 }
        },
        "queries": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["query"],
            "properties": {
              "query": { "type": "string", "maxLength": 256 },
              "assetType": { "type": "string", "enum": ["all", "scenes", "scripts", "shaders", "models", "textures", "audio"] },
              "required": { "type": "boolean", "default": false },
              "maxResults": { "type": "integer", "minimum": 1, "maximum": 2000 }
            }
          }
        }
      }
    },
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "commandsPath": { "type": "string", "minLength": 1 },
        "commands": { "type": "array", "minItems": 1, "maxItems": 128 },
        "checkAssets": { "type": "boolean", "default": true },
        "outputPath": { "type": "string", "description": "必须位于 out/agent_game_specs 下；省略时由执行器生成隔离路径。" }
      },
      "oneOf": [
        { "required": ["commandsPath"], "not": { "required": ["commands"] } },
        { "required": ["commands"], "not": { "required": ["commandsPath"] } }
      ]
    },
    "scripts": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["scriptName", "outputPath"],
        "properties": {
          "scriptName": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$" },
          "className": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$" },
          "outputPath": { "type": "string", "pattern": "^(games|projects/[^/]+/games)/.+\\.cpp$" },
          "fields": { "type": "array", "maxItems": 32 },
          "source": { "type": "string", "maxLength": 200000 },
          "sourcePath": { "type": "string", "minLength": 1 },
          "overwrite": { "type": "boolean", "default": false }
        },
        "oneOf": [
          { "not": { "required": ["source", "sourcePath"] } },
          { "required": ["source"], "not": { "required": ["sourcePath"] } },
          { "required": ["sourcePath"], "not": { "required": ["source"] } }
        ]
      }
    },
    "tests": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "gameplay": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean", "default": true },
            "frames": { "type": "integer", "minimum": 1, "maximum": 1000000 },
            "fixedDeltaSeconds": { "type": "number", "exclusiveMinimum": 0, "maximum": 0.1 },
            "timeoutMs": { "type": "integer", "minimum": 1000, "maximum": 7200000 },
            "extraArgs": { "type": "array", "items": { "type": "string" } }
          }
        },
        "assertions": { "type": "array", "maxItems": 128 },
        "render": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean", "default": false },
            "frames": { "type": "integer", "minimum": 1, "maximum": 1000000 },
            "fixedDeltaSeconds": { "type": "number", "exclusiveMinimum": 0, "maximum": 0.1 },
            "timeoutMs": { "type": "integer", "minimum": 1000, "maximum": 7200000 },
            "screenshotFrame": { "type": "integer", "minimum": 0, "maximum": 1000000, "default": 0, "description": "0=不截图；否则导出 PNG 和同名 JSON，并检查 runtimeReady/黑屏状态" },
            "extraArgs": { "type": "array", "items": { "type": "string" } }
          }
        },
        "capture": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean", "default": false },
            "captureFrame": { "type": "integer", "minimum": 1, "maximum": 1000000 },
            "frames": { "type": "integer", "minimum": 1, "maximum": 1000000 },
            "fixedDeltaSeconds": { "type": "number", "exclusiveMinimum": 0, "maximum": 0.1 },
            "captureWaitSeconds": { "type": "integer", "minimum": 0, "maximum": 120 },
            "captureTimeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 3600 },
            "renderDocCmdPath": { "type": "string" },
            "apiValidation": { "type": "boolean" },
            "captureCallstacks": { "type": "boolean" },
            "skipThumbnail": { "type": "boolean" },
            "extraArgs": { "type": "array", "items": { "type": "string" } }
          }
        },
        "performance": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean", "default": false },
            "captureType": { "type": "string", "enum": ["gpu_trace", "graphics_capture"] },
            "captureFrame": { "type": "integer", "minimum": 1, "maximum": 1000000 },
            "frames": { "type": "integer", "minimum": 1, "maximum": 1000000 },
            "fixedDeltaSeconds": { "type": "number", "exclusiveMinimum": 0, "maximum": 0.1 },
            "frameCount": { "type": "integer", "minimum": 1, "maximum": 1000000 },
            "maxDurationMilliseconds": { "type": "integer", "minimum": 1, "maximum": 7200000 },
            "captureTimeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 3600 },
            "traceTimeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 7200 },
            "replayLoops": { "type": "integer", "minimum": 1, "maximum": 100 },
            "skipReplay": { "type": "boolean" },
            "nsightPath": { "type": "string" },
            "setGpuClocks": { "type": "boolean" },
            "extraArgs": { "type": "array", "items": { "type": "string" } },
            "thresholds": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "maxGpuFrameTimeMs": { "type": "number", "exclusiveMinimum": 0 },
                "maxDrawCount": { "type": "integer", "minimum": 0 },
                "maxDispatchCount": { "type": "integer", "minimum": 0 },
                "maxGraphicsEngineActivePct": { "type": "number", "minimum": 0, "maximum": 100 },
                "maxSmThroughputPct": { "type": "number", "minimum": 0, "maximum": 100 },
                "maxL1texThroughputPct": { "type": "number", "minimum": 0, "maximum": 100 },
                "maxDramThroughputPct": { "type": "number", "minimum": 0, "maximum": 100 },
                "maxPcieThroughputPct": { "type": "number", "minimum": 0, "maximum": 100 }
              }
            }
          }
        }
      }
    },
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean", "default": true },
        "packageZip": { "type": "boolean", "default": true },
        "includeBuildArtifacts": { "type": "boolean", "default": false },
        "includeCaptures": { "type": "boolean", "default": false }
      }
    }
  }
}
