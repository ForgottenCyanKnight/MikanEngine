{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "mikanengine/agent_task.schema.json",
  "title": "MikanEngine Agent Task",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "candidates"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "name": { "type": "string", "maxLength": 160 },
    "description": { "type": "string", "maxLength": 2000 },
    "workflowPath": { "type": "string", "minLength": 1 },
    "workflow": { "type": "object" },
    "mode": { "type": "string", "enum": ["preview", "execute"], "default": "preview" },
    "maxAttempts": { "type": "integer", "minimum": 1, "maximum": 5, "default": 2 },
    "timeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 7200, "default": 1800 },
    "candidates": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "patches"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$" },
          "description": { "type": "string", "maxLength": 1000 },
          "when": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "stepId": { "type": "string" },
              "action": { "type": "string" },
              "failureCategory": { "type": "string" }
            }
          },
          "patches": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["stepId", "path", "value"],
              "properties": {
                "op": { "type": "string", "enum": ["set"], "default": "set" },
                "stepId": { "type": "string" },
                "path": { "type": "string", "pattern": "^args\\.[A-Za-z][A-Za-z0-9_]*$" },
                "value": {}
              }
            }
          }
        }
      }
    }
  },
  "oneOf": [
    { "required": ["workflowPath"], "not": { "required": ["workflow"] } },
    { "required": ["workflow"], "not": { "required": ["workflowPath"] } }
  ]
}
