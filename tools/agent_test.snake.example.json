{
  "schemaVersion": 1,
  "name": "snake-color-block-agent-test",
  "description": "只使用 Sprite2D 色块验证 Snake 玩法、回放输入和状态断言。",
  "goal": "验证一个不依赖真实素材的 2D Snake 原型：加载场景、自动开始、按固定回放移动，并断言蛇头、食物和菜单状态。",
  "mode": "preview",
  "project": {
    "scenePath": "assets/snake.json",
    "game": "snake"
  },
  "assets": {
    "queries": [
      {
        "query": "snake",
        "assetType": "scenes",
        "required": true,
        "maxResults": 20
      }
    ]
  },
  "tests": {
    "compileGames": false,
    "gameplay": {
      "enabled": true,
      "frames": 60,
      "fixedDeltaSeconds": 0.016666667,
      "timeoutMs": 120000,
      "replayPath": "tools/agent_replay.snake.example.json",
      "extraArgs": ["--auto-start-game"]
    },
    "assertions": [
      {
        "entityName": "Snake0",
        "field": "wpos",
        "expected": [96, 96, 0],
        "tolerance": 0.001
      },
      {
        "entityName": "Food",
        "field": "wpos",
        "expected": [-384, -288, 0],
        "tolerance": 0.001
      },
      {
        "entityName": "MenuTitle",
        "field": "visible",
        "expected": false
      }
    ],
    "render": {
      "enabled": false
    },
    "capture": {
      "enabled": false
    },
    "performance": {
      "enabled": false
    }
  }
}
