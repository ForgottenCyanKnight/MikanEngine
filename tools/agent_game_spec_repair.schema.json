{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mikanengine://tools/agent_game_spec_repair.schema.json",
  "title": "MikanEngine AI Native GameSpec Repair",
  "description": "模型根据失败证据生成的受限 GameSpec 修复规格；不允许修改项目边界、验收断言或执行任意命令。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "action", "name", "diagnosis", "patches"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "GameSpecRepair" },
    "action": { "type": "string", "enum": ["repair", "stop"] },
    "name": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,159}$" },
    "diagnosis": { "type": "string", "maxLength": 4000 },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "patches": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "value"],
        "properties": {
          "op": { "const": "set", "default": "set" },
          "path": {
            "type": "string",
            "pattern": "^(scene\\.commands|tests\\.(gameplay\\.timeoutMs|render\\.timeoutMs|capture\\.(captureTimeoutSeconds|captureWaitSeconds)|performance\\.(captureTimeoutSeconds|traceTimeoutSeconds))|scripts\\[[0-9]+\\]\\.source)$"
          },
          "value": {},
          "reason": { "type": "string", "maxLength": 1000 }
        }
      }
    }
  }
}
