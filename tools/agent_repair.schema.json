{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mikanengine://tools/agent_repair.schema.json",
  "title": "MikanEngine AI Native controlled test repair",
  "description": "针对失败 Agent TestSpec 的受控参数修复；只允许修改测试 workflow 的白名单 args，不写入场景、脚本或引擎源码。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "name", "candidates"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "name": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,159}$" },
    "description": { "type": "string", "maxLength": 2000 },
    "mode": { "enum": ["preview", "execute"], "default": "preview" },
    "maxAttempts": { "type": "integer", "minimum": 1, "maximum": 5, "default": 2 },
    "timeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 7200, "default": 7200 },
    "candidates": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "patches"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$" },
          "description": { "type": "string", "maxLength": 1000 },
          "when": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "stepId": { "type": "string" },
              "action": { "type": "string" },
              "failureCategory": { "type": "string" }
            }
          },
          "patches": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["stepId", "path", "value"],
              "properties": {
                "op": { "enum": ["set"], "default": "set" },
                "stepId": { "type": "string" },
                "path": { "type": "string", "pattern": "^args\\.[A-Za-z][A-Za-z0-9_]*$" },
                "value": {}
              }
            }
          }
        }
      }
    }
  }
}
