# ================================================
# MikanEngine .gitignore
# 决策（2026 用户拍板）：
#   - 大内容资产不进 git（assets/models/ 与 projects/ 下大二进制）
#   - 源码 / 配置 / 小资源 / 第三方工具（lib、dll、tools/glslang、dependencies）全部提交
#   - BVH 缓存、shader 编译产物（.spv）可再生成，忽略
# ================================================

# ---------- 构建产物 ----------
/out/
/build/

# ---------- Windows EXE branding（本地定制，不进入开源仓库） ----------
# EXE 图标生成工具与 Windows 资源可在开发机保留，但不作为引擎源码发布。
/resources/windows/
/tools/generate_windows_icon.ps1
/assets/ui/mikan_engine_icon.png
/assets/ui/mikan_engine_splash.png
/projects/**/ui/mikan_engine_splash.png

# ---------- Android（当前项目暂不纳入首次 Git 提交） ----------
/android/

# ---------- IDE / 编辑器 ----------
/.vs/
/.idea/
/.trae/
*.user
*.suo

# ---------- 运行时临时文件与日志 ----------
/engine.log
*.log
/crash_log.txt
/log/
/imgui.ini
/t.json
/auto_save.json
/modelloder.txt

# ---------- 缓存（可再生成） ----------
/bvh/
/models/
**/*_bvh.txt

# ---------- 备份 ----------
# ⚠️ 备份文件（*.bak* / _backup_*）统一放外部 D:\Engine project\backup\——源码树内禁止遗留任何 bak（2026-08-26 已清 116 个，规则见 AGENTS.md "备份纪律"）
*.bak*
/_backup_*/
/_*_bak*/
/_*_bak_*/
/backup/

# ---------- 已废弃的临时目录 ----------
/third_party/

# ---------- 本地 AI Native 调试产物 ----------
/debug_captures/
/tmp/
/VP_VULKANINFO_*.json
**/__pycache__/
*.pyc

# ---------- 仅供本地的开发文档与实验资料 ----------
# 公开说明保留在 README.md；以下文档包含 Agent 上下文、本机路径、会话记录、路线图或未完成方案。
/AGENTS.md
/PROJECT_CONTEXT.md
/编译命令.md
/docs/
/tools/agent-cli/README.md
/plan/

# ---------- 本地生成缓存 ----------
**/*_tlas.txt

# ---------- KTX 运行时 ----------
# CMake 从 tools/ktx/bin/ktx.dll 复制 KTX 运行时；旧的本地副本不再入库。
/lib/x64/ktx.dll

# ---------- 顶层游戏导出产物（*.obj 由游戏插件导出） ----------
/*.obj

# ---------- 大内容资产（不进 git） ----------
/assets/models/
/assets/Bistro_v5_2/
/assets/engine_20260814_pre_csm/
/projects/**/*.fbx
/projects/**/*.ktx2
/projects/**/*.tga
/projects/**/*.dds
/projects/**/*.hdr
/projects/**/*.obj

# Android 整目录已在上方忽略；保留 Android 文件不会进入首次提交。
*.apk
*.aab

# ---------- shader 编译产物（源码已提交，由 tools/glslang + compile_shaders 重建） ----------
**/*.spv
