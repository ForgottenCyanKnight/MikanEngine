# ================================================
# MikanEngine .gitignore
#   - Large content assets stay outside the source distribution.
#   - Source, configuration and required third-party build inputs remain tracked.
#   - Generated caches and shader binaries are reproducible and ignored.
# ================================================

# ---------- 构建产物 ----------
/out/
/build/

# ---------- Windows EXE branding ----------
# Optional local branding inputs are not required to build the engine.
/resources/windows/
/tools/generate_windows_icon.ps1
/assets/ui/mikan_engine_icon.png
/assets/ui/mikan_engine_splash.png
/projects/**/ui/mikan_engine_splash.png

# ---------- Android ----------
# Android 工程源码、Gradle 配置、Android 资源和可复现构建所需依赖进入仓库。
# 本机 SDK 配置、Gradle/CMake 缓存、同步生成的 APK assets 和诊断资料不进入仓库。
/android/.android-user-home/
/android/.gradle/
/android/.gradle-home/
/android/.gradle-user-home/
/android/.idea/
/android/_sdl_aar/
/android/temp_sdl/
/android/build/
/android/app/.cxx/
/android/app/build/
/android/app/src/main/assets/
/android/local.properties
/android/*.log
/android/*.png
/android/*.txt
/android/*.zip
/android/**/*.zip
/android/*.md
/android/app/libs/x86_64/
/android/app/libs/arm64-v8a/libSDL3.so
/android/app/libs/arm64-v8a/libSDL3_image.so

# ---------- IDE / 编辑器 ----------
/.vs/
/.idea/
/.trae/
*.user
*.suo

# ---------- 运行时临时文件与日志 ----------
/engine.log
*.log
/crash_log.txt
/log/
/imgui.ini
/t.json
/auto_save.json
/modelloder.txt

# ---------- 缓存（可再生成） ----------
/bvh/
/models/
**/*_bvh.txt

# ---------- 备份 ----------
# Local backup snapshots are not part of the source distribution.
*.bak*
/_backup_*/
/_*_bak*/
/_*_bak_*/
/backup/

# ---------- Legacy local directories ----------
/third_party/

# ---------- Local AI and debugging artifacts ----------
/debug_captures/
/tmp/
/VP_VULKANINFO_*.json
**/__pycache__/
*.pyc

# ---------- Private development notes ----------
# Public usage and build information belongs in README.md.
/AGENTS.md
/PROJECT_CONTEXT.md
/编译命令.md
/docs/
/tools/agent-cli/README.md
/plan/

# ---------- 本地生成缓存 ----------
**/*_tlas.txt

# ---------- KTX 运行时 ----------
# CMake copies the runtime from tools/ktx/bin/ktx.dll.
/lib/x64/ktx.dll

# ---------- KTX generated documentation ----------
# KTX-Software generated documentation is not required for engine builds.
/tools/ktx/share/doc/

# ---------- 顶层游戏导出产物（*.obj 由游戏插件导出） ----------
/*.obj

# ---------- Large content assets ----------
# Project-owned assets belong under projects/<project-name>.
/assets/
/assets/models/
/assets/Bistro_v5_2/
/assets/engine_20260814_pre_csm/
/projects/**/*.fbx
/projects/**/*.ktx2
/projects/**/*.tga
/projects/**/*.dds
/projects/**/*.hdr
/projects/**/*.obj

# Android 发布产物
*.apk
*.aab

# ---------- shader 编译产物（源码已提交，由 tools/glslang + compile_shaders 重建） ----------
**/*.spv
