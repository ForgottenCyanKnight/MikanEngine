#version 450
#extension GL_GOOGLE_include_directive : require
layout(local_size_x=64) in;
layout(std430,binding=0) readonly buffer Quads { uint quadWords[]; };
#include "vox_quad_decode.glsl"
layout(std430,binding=1) writeonly buffer Positions { float positions[]; };
layout(std430,binding=2) writeonly buffer Indices { uint indices[]; };
layout(push_constant) uniform Params { vec4 minSize; uvec4 range; } pc;
void main() {
    uint id=gl_GlobalInvocationID.x;if(id>=pc.range.y)return;
    uint q=pc.range.x+id;uvec2 decoded=voxDecodeQuad(q);uint g=decoded.x,a=decoded.y;uint face=pc.range.z;
    vec3 origin=vec3(g&255u,(g>>8)&255u,(g>>16)&255u);
    if(face==0u)origin.z+=1;else if(face==3u)origin.x+=1;else if(face==4u)origin.y+=1;
    vec2 size=vec2((g>>24)+1u,(a&255u)+1u);
    const vec2 pz[4]=vec2[4](vec2(0,0),vec2(1,0),vec2(1,1),vec2(0,1));
    const vec2 nz[4]=vec2[4](vec2(0,0),vec2(0,1),vec2(1,1),vec2(1,0));
    const vec2 nx[4]=vec2[4](vec2(1,0),vec2(1,1),vec2(0,1),vec2(0,0));
    const vec2 px[4]=vec2[4](vec2(0,0),vec2(0,1),vec2(1,1),vec2(1,0));
    const vec2 py[4]=vec2[4](vec2(0,0),vec2(0,1),vec2(1,1),vec2(1,0));
    const vec2 ny[4]=vec2[4](vec2(0,1),vec2(0,0),vec2(1,0),vec2(1,1));
    for(uint corner=0;corner<4u;++corner) {
        vec2 uv=face==0u?pz[corner]:(face==1u?nz[corner]:(face==2u?nx[corner]:(face==3u?px[corner]:(face==4u?py[corner]:ny[corner]))));
        vec2 offset=uv*size;
        vec3 grid=origin+(face<2u?vec3(offset,0):(face<4u?vec3(0,offset.y,offset.x):vec3(offset.x,0,offset.y)));
        vec3 position=grid*pc.minSize.w+pc.minSize.xyz;uint base=(q*4u+corner)*3u;
        positions[base]=position.x;positions[base+1u]=position.y;positions[base+2u]=position.z;
    }
    const uint corners[6]=uint[6](0,2,1,0,3,2);
    for(uint i=0;i<6u;++i)indices[q*6u+i]=q*4u+corners[i];
}
