// 重投影复用 skyRT（已算好的散射），省掉 cube 自己的 24576 次 GetSkyRadiance（~1-2ms → ~0.1ms）
// ⚠️ 与 atmo_sky.comp 的 skylutdir 互为逆（同一 CAM_ALT、EARTH_R、pow4 expo——此处复制 fullscreen.frag 的 skylutuv）
// ⚠️ skyRT 是 LogLuv32（RGBA8，×10 曝光）——解码后保持 ×10（与散射版 cube 直读语义一致）
#version 450
#extension GL_GOOGLE_include_directive : require
#include "atmo_common.glsl"   // GetSkyRadiance + BOTTOM_RADIUS（天顶 per-pixel 散射）

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform sampler2D skyRT;          // LogLuv32 RGBA8 全景（×10 曝光）
layout(set = 0, binding = 1, rgba16f) uniform writeonly image2DArray skyCube;   // 线性 16F（×10 保持）
layout(set = 0, binding = 2) uniform sampler2D transmittanceLUT;
layout(set = 0, binding = 3) uniform sampler3D scatteringLUT;

layout(push_constant) uniform PC {
    vec4 sunDir;      // 保留结构（无用）
    ivec2 cubeSize;   // 每面分辨率（.x = .y）
    float camAltMeters;
};

// PI 来自 atmo_common.glsl（include 已提供，勿重复定义）

// —— 逆映射（方向 → skyRT uv）——复制 fullscreen.frag 的 skylutuv（km 单位）
float linestep(float edge0, float edge1, float x) {
    return clamp((x - edge0) / (edge1 - edge0), 0.0, 1.0);
}
float safeacos(float x) {
    return acos(clamp(x, -1.0, 1.0));
}
vec2 skylutuv(vec3 rayDir, float camAltMeters) {
    const float EARTH_R = 6371.0;
    const float EARTH_R2 = EARTH_R * EARTH_R;
    float CAM_ALT = max(camAltMeters, 0.0) / 1000.0;   // m → km（与生成端 skylutdir 的单位一致约定）
    float r2 = (EARTH_R + CAM_ALT) * (EARTH_R + CAM_ALT);
    float r = sqrt(r2);

    float horizonAngle = safeacos(sqrt(r2 - EARTH_R2) / r);
    float altitudeAngle = horizonAngle - acos(clamp(rayDir.y, -1.0, 1.0));
    float v = 0.5 + 0.5 * sign(altitudeAngle) * abs(altitudeAngle) * 2.0 / PI;

    vec2 uv = vec2(atan(-rayDir.x, -rayDir.z) / (2.0 * PI) + 0.5, v);

    float s = EARTH_R / r;
    float y = -sqrt(1.0 - s * s);
    float t = clamp(y * 0.5 + 0.5, 0.0, 1.0);
    float x = mix(linestep(t, 1.0, uv.y), linestep(t, 0.0, uv.y), float(uv.y < t));
    // 海拔自适应 pow4 逆（与 atmo_sky.comp skylutdir 同一 expo——互逆）
    float expo = mix(4.0, 1.0, clamp(camAltMeters / 60000.0, 0.0, 1.0));
    x = pow(x, 1.0 / expo);
    uv.y = mix((x * (1.0 - t) + t), (-x * t + t), float(uv.y < t)) * 0.5 + 0.5;
    return uv;
}

// —— LogLuv32 解码（与 fullscreen.frag 同）——
const mat3 COLORS_LOGLUV32_INVERSE_M = mat3(
    6.0014, -2.7008, -1.7996,
    -1.3320, 3.1029, -5.7721,
    0.3008, -1.0882, 5.6268
);
vec3 colors_LogLuv32ToSRGB(in vec4 vLogLuv) {
    if (all(lessThanEqual(vLogLuv, vec4(0.0)))) {
        return vec3(0.0);
    }
    float Le = vLogLuv.z * 255.0 + vLogLuv.w;
    vec3 Xp_Y_XYZp;
    Xp_Y_XYZp.y = exp2((Le - 127.0) / 2.0);
    Xp_Y_XYZp.z = Xp_Y_XYZp.y / vLogLuv.y;
    Xp_Y_XYZp.x = vLogLuv.x * Xp_Y_XYZp.z;
    vec3 vRGB = COLORS_LOGLUV32_INVERSE_M * Xp_Y_XYZp;
    return max(vRGB, vec3(0.0));   // 线性 RGB（sRGB 色域）
}

// —— cube 面方向（与 atmo_sky_cube.comp 同）——
vec3 FaceDir(int face, vec2 ndc) {
    switch (face) {
        case 0: return normalize(vec3( 1.0, -ndc.y, -ndc.x));   // +X
        case 1: return normalize(vec3(-1.0, -ndc.y,  ndc.x));   // -X
        case 2: return normalize(vec3( ndc.x,  1.0,  ndc.y));   // +Y
        case 3: return normalize(vec3( ndc.x, -1.0, -ndc.y));   // -Y
        case 4: return normalize(vec3( ndc.x, -ndc.y,  1.0));   // +Z
        default: return normalize(vec3(-ndc.x, -ndc.y, -1.0));  // -Z
    }
}

float TransLUT_DistanceToTop(float r, float mu) {
    float disc = r * r * (mu * mu - 1.0) + TOP_RADIUS * TOP_RADIUS;
    return max(-r * mu + sqrt(max(disc, 0.0)), 0.0);
}
vec2 TransLUT_Uv(float r, float mu) {
    float H = sqrt(TOP_RADIUS * TOP_RADIUS - BOTTOM_RADIUS * BOTTOM_RADIUS);
    float rho = sqrt(max(r * r - BOTTOM_RADIUS * BOTTOM_RADIUS, 0.0));
    float d = TransLUT_DistanceToTop(r, mu);
    float d_min = TOP_RADIUS - r;
    float d_max = rho + H;
    float x_mu = (d - d_min) / (d_max - d_min);
    float x_r = rho / H;
    float u = 0.5 / 256.0 + x_mu * (1.0 - 1.0 / 256.0);
    float v = 0.5 / 64.0 + x_r * (1.0 - 1.0 / 64.0);
    return vec2(clamp(u, 0.0, 1.0), clamp(v, 0.0, 1.0));
}

void main() {
    ivec3 gid = ivec3(gl_GlobalInvocationID);
    if (gid.x >= cubeSize.x || gid.y >= cubeSize.y || gid.z >= 6) return;
    vec2 ndc = (vec2(gid.xy) + 0.5) / vec2(cubeSize) * 2.0 - 1.0;
    vec3 dir = FaceDir(gid.z, ndc);
    vec2 uv = skylutuv(dir, camAltMeters);
    uv.y = 0.5 + (uv.y - 0.5) * 0.99;   // 向中段压缩 1%（两极稍微内收）
    vec3 rgb = colors_LogLuv32ToSRGB(texture(skyRT, uv));

    //（mip0 反射无太阳 → smooth 最高档球"不清晰"；GGX 预滤波反而把亚像素亮核摊开成可见光斑）
    // 画 ~1.5° 盘（≈2px）→ mip0 反射清晰太阳像，预滤波按 roughness 自然模糊扩散——真正 PBR 参数驱动
    vec3 sunN = normalize(sunDir.xyz);
    float sunCosA = dot(dir, sunN);
    float sunRadius = 1.5 * 3.14159265 / 180.0;   // ~1.5° 可见盘（>0.275° 物理值——低分辨率可见性需要）
    float sunMask = smoothstep(cos(sunRadius), cos(sunRadius * 0.75), sunCosA);
    // 否则 cubemap 底部（地平线下方向）也出现太阳盘（已知 bug：圆盘在地平线下没消失）
    sunMask *= smoothstep(-0.01, 0.01, sunN.y);
    if (sunMask > 0.001) {
        // 太阳表面亮度 = SOLAR_IRRADIANCE/π × 透射率（与 fullscreen.frag sunDiskColor 同源），归一化取色相（正午白/落山红）
        vec2 sunUV = TransLUT_Uv(BOTTOM_RADIUS + camAltMeters, clamp(sunN.y, -1.0, 1.0));
        vec3 sunTrans = texture(transmittanceLUT, sunUV).rgb;
        vec3 sunDisk = (SOLAR_IRRADIANCE / PI) * sunTrans;
        sunDisk /= max(max(sunDisk.r, sunDisk.g), sunDisk.b) + 1e-6;
        rgb += sunDisk * sunMask;
    }

    imageStore(skyCube, ivec3(gid.xy, gid.z), vec4(rgb, 1.0));
}
