#version 450
#extension GL_GOOGLE_include_directive : require
// atmo_multiscatter.comp — 第 n 阶多重散射（50 步视线积分）→ 双写（2026-08-11 严格 n-1 阶版）：
//   deltaMultiLUT（覆盖，含相函数——下一阶 density 的入射场，官方 delta_multiple_scattering 语义）
//   + 累加进 scatteringLUT.RGB（除瑞利相函数存储，combined 约定；A 通道=单次 Mie.R 不动）
#include "atmo_common.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 4) in;

layout(set = 0, binding = 0, rgba32f) uniform image3D scatteringLUT;   // 读改写（累加 RGB）
layout(set = 0, binding = 1) uniform sampler3D densityLUT;
layout(set = 0, binding = 2) uniform sampler2D transmittanceLUT;
layout(set = 0, binding = 3, rgba32f) uniform writeonly image3D deltaMultiLUT;  // 写（覆盖）

void main() {
    ivec3 px = ivec3(gl_GlobalInvocationID.xyz);
    if (px.x >= SCATTERING_TEXTURE_WIDTH || px.y >= SCATTERING_TEXTURE_HEIGHT ||
        px.z >= SCATTERING_TEXTURE_DEPTH) return;

    vec3 fragCoord = vec3(px) + 0.5;
    float r, mu, mu_s, nu;
    bool rayIntersectsGround;
    GetRMuMuSNuFromScatteringTextureFragCoord(fragCoord, r, mu, mu_s, nu, rayIntersectsGround);

    vec3 multi = ComputeMultipleScattering(transmittanceLUT, densityLUT, r, mu, mu_s, nu,
                                           rayIntersectsGround);
    // deltaMulti：本阶纯多次散射（含相函数），下一阶 density 当入射场直接用
    imageStore(deltaMultiLUT, px, vec4(multi, 1.0));
    // 除瑞利相函数存储（GetSkyRadiance 渲染时乘回）；nu=0 时 RPhase=3/(16π) 最小，无除零
    vec4 prev = imageLoad(scatteringLUT, px);
    prev.rgb += multi / RayleighPhaseFunction(nu);
    imageStore(scatteringLUT, px, prev);
}
