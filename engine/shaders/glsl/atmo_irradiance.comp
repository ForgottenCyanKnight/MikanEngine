#version 450
#extension GL_GOOGLE_include_directive : require
//   deltaIrrLUT（覆盖，第 n 阶纯间接辐照度——下一阶 density 的地面反弹场，官方 delta_irradiance 语义）
//   + 累加进 irradianceLUT（渲染用累计，官方 irradiance_texture 语义）
// 入射场同 density（严格 n-1 阶：order==1 单次、order>=2 deltaMulti）
#include "atmo_common.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0, rgba32f) uniform image2D irradianceLUT;  // 读改写（累加）
layout(set = 0, binding = 1, rgba32f) uniform writeonly image2D deltaIrrLUT;  // 写（覆盖）
layout(set = 0, binding = 2) uniform sampler3D singleScatLUT;
layout(set = 0, binding = 3) uniform sampler3D deltaMultiLUT;

layout(push_constant) uniform PC { int order; } pc;   // C++ 传 n-1（n=散射阶 2..N）

void main() {
    ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    if (px.x >= IRRADIANCE_TEXTURE_WIDTH || px.y >= IRRADIANCE_TEXTURE_HEIGHT) return;

    vec2 uv = (vec2(px) + 0.5) / vec2(IRRADIANCE_TEXTURE_WIDTH, IRRADIANCE_TEXTURE_HEIGHT);
    float r, mu_s;
    GetRMuSFromIrradianceTextureUv(uv, r, mu_s);

    vec3 indirect = ComputeIndirectIrradiance(singleScatLUT, deltaMultiLUT, r, mu_s, pc.order);

    imageStore(deltaIrrLUT, px, vec4(indirect, 1.0));
    vec4 prev = imageLoad(irradianceLUT, px);
    prev.rgb += indirect;
    imageStore(irradianceLUT, px, prev);
}
