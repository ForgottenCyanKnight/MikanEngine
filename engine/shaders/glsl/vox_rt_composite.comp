#version 450
layout(local_size_x=8,local_size_y=8) in;
layout(rgba16f,binding=0) uniform image2D outputImage;
layout(binding=1) uniform sampler2D diffuseTex;
layout(binding=2) uniform sampler2D materialTex;
layout(binding=3) uniform sampler2D specularTex;
layout(binding=4) uniform sampler2D specularMaterialTex;
void main(){
    ivec2 p=ivec2(gl_GlobalInvocationID.xy);
    if(any(greaterThanEqual(p,imageSize(outputImage))))return;
    vec4 base=imageLoad(outputImage,p),material=texelFetch(materialTex,p,0);
    vec3 indirect=material.a>.5 ? texelFetch(diffuseTex,p,0).rgb*material.rgb : vec3(0);
    vec3 reflection=texelFetch(specularTex,p,0).rgb*texelFetch(specularMaterialTex,p,0).rgb;
    imageStore(outputImage,p,vec4(max(base.rgb+indirect+reflection,vec3(0)),1));
}
