#version 450
#extension GL_GOOGLE_include_directive : require
// 6 face × W×W：uv → face 方向（标准 cube 映射，90° 视锥）→ GetSkyRadiance → LogLuv32
// 与 atmo_sky.comp 同 LUT/同曝光/同海拔；各向同性——无柱面极区聚集（IBL 专用，主天空仍用柱面 skyRT）
#include "atmo_common.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0, rgba16f) uniform writeonly image2DArray skyCube;
layout(set = 0, binding = 1) uniform sampler2D transmittanceLUT;
layout(set = 0, binding = 2) uniform sampler3D scatteringLUT;

layout(push_constant) uniform PC {
    vec4 sunDir;    // .xyz = 太阳方向（世界，单位向量）；.w = 曝光（与 atmo_sky.comp 同值）
    ivec2 skySize;  // 每面分辨率
    float altitudeMeters;   // 相机海拔（m，CPU 已 max(0, 相机y+200)）
} pc;

float TransLUT_DistanceToTop(float r, float mu) {
    float disc = r * r * (mu * mu - 1.0) + TOP_RADIUS * TOP_RADIUS;
    return max(-r * mu + sqrt(max(disc, 0.0)), 0.0);
}
vec2 TransLUT_Uv(float r, float mu) {
    float H = sqrt(TOP_RADIUS * TOP_RADIUS - BOTTOM_RADIUS * BOTTOM_RADIUS);
    float rho = sqrt(max(r * r - BOTTOM_RADIUS * BOTTOM_RADIUS, 0.0));
    float d = TransLUT_DistanceToTop(r, mu);
    float d_min = TOP_RADIUS - r;
    float d_max = rho + H;
    float x_mu = (d - d_min) / (d_max - d_min);
    float x_r = rho / H;
    float u = 0.5 / 256.0 + x_mu * (1.0 - 1.0 / 256.0);
    float v = 0.5 / 64.0 + x_r * (1.0 - 1.0 / 64.0);
    return vec2(clamp(u, 0.0, 1.0), clamp(v, 0.0, 1.0));
}
const mat3 COLORS_LOGLUV32_M = mat3(
    0.2209, 0.3390, 0.4184,
    0.1138, 0.6780, 0.7319,
    0.0102, 0.1130, 0.2969
);

vec4 colors_sRGBToLogLuv32(in vec3 vRGB) {
    if (all(lessThanEqual(vRGB, vec3(0.0)))) {
        return vec4(0.0);
    }
    vec3 Xp_Y_XYZp = COLORS_LOGLUV32_M * vRGB;
    Xp_Y_XYZp = max(Xp_Y_XYZp, vec3(1e-6));
    vec2 xy = Xp_Y_XYZp.xy / Xp_Y_XYZp.z;
    float Le = 2.0 * log2(Xp_Y_XYZp.y) + 127.0;
    float w = fract(Le);
    float z = (Le - floor(w * 255.0) / 255.0) / 255.0;
    return vec4(xy, z, w);
}

// 标准 cube face 方向（Vulkan 约定——ndc ∈ [-1,1]²）
vec3 FaceDir(int face, vec2 ndc) {
    switch (face) {
        case 0: return normalize(vec3( 1.0, -ndc.y, -ndc.x));   // +X
        case 1: return normalize(vec3(-1.0, -ndc.y,  ndc.x));   // -X
        case 2: return normalize(vec3( ndc.x,  1.0,  ndc.y));   // +Y
        case 3: return normalize(vec3( ndc.x, -1.0, -ndc.y));   // -Y
        case 4: return normalize(vec3( ndc.x, -ndc.y,  1.0));   // +Z
        default: return normalize(vec3(-ndc.x, -ndc.y, -1.0));  // -Z
    }
}

void main() {
    ivec3 gid = ivec3(gl_GlobalInvocationID);
    if (gid.x >= pc.skySize.x || gid.y >= pc.skySize.y || gid.z >= 6) return;
    vec2 uv = (vec2(gid.xy) + 0.5) / vec2(pc.skySize);
    vec2 ndc = uv * 2.0 - 1.0;
    vec3 dir = FaceDir(gid.z, ndc);
    vec3 skyView = dir;
    float depthFade = 1.0;
    if (dir.y < 0.0) {
        skyView.y = 0.0;
        depthFade = exp(-max(-dir.y, 0.0) * 3.0);
    }
    // 地表相机（与 atmo_sky.comp 同一约定：BOTTOM_RADIUS + 海拔）
    vec3 campos = vec3(0.0, BOTTOM_RADIUS + max(pc.altitudeMeters, 0.0), 0.0);
    vec3 sun = normalize(pc.sunDir.xyz);
    vec3 transmittance;
    vec3 color = GetSkyRadiance(transmittanceLUT, scatteringLUT, campos, skyView, 0.0, sun, transmittance);
    float nightFade = 1.0 - smoothstep(-0.5, -0.1, sun.y);
    vec3 moonDir = -sun;
    vec3 moonTransmittance;
    vec3 moonColor = GetSkyRadiance(transmittanceLUT, scatteringLUT, campos, skyView, 0.0, moonDir, moonTransmittance) * depthFade;
    color += moonColor * (0.005+0.005*nightFade);

    imageStore(skyCube, ivec3(gid.xy, gid.z), vec4(color, 1.0));
}
