#version 450
// CMAA2 pass 2: 形状处理 — Intel CMAA2.hlsl ProcessCandidatesCS 官方语义完整移植（单 MSAA）
// Simple（ComputeSimpleShapeBlendValues）+ Z（DetectZs + FindZLineLengths + BlendZs）
// 输出 = 混合后的颜色 → 直接 imageStore 写 result 图（2026-08-17 最终方案：每候选 1 次随机写）——
//   单 MSAA 每像素唯一候选 → 官方 DeferredColorApply 的 weight 归一化抵消 → final = 混合色本身；
//   result 每帧 clear（alpha=0）→ cmaa_apply.frag 用 alpha 区分 result/tonemap 原色
layout(local_size_x = 128) in;

layout(binding = 0) uniform sampler2D colorTex;   // tonemap 输出（SHADER_READ_ONLY 布局采样——GENERAL 布局在 NVIDIA 不可靠）
layout(binding = 1, std430) readonly buffer CandidateBuf {
    uint count;
    uint data[];
};
layout(binding = 2, r8ui) uniform readonly uimage2D edgesImg;
layout(binding = 3, rgba8) uniform writeonly image2D resultImg;   // result 图（每帧 clear 后 GENERAL；alpha=1 标记已混合）

// 官方 HIGH 预设常量
const float CMAA2_SIMPLE_SHAPE_BLURINESS = 0.10;
const float CMAA2_MAX_LINE_LENGTH = 64.0;   // 2026-08-17 用户拍板：官方 HIGH 默认 86 → 64（折中——线追踪成本 -26%，视觉基本无差）
const float CMAA2_SYMMETRY_CORRECTION_OFFSET = 0.22;
const float CMAA2_DAMPENING_EFFECT = 0.15;

// ---- 边缘加载/解包（全宽 R8UINT，4bit：右=1 下=2 左=4 上=8）----
uint LoadEdgePacked(ivec2 pos) {
    ivec2 sz = imageSize(edgesImg);
    pos = clamp(pos, ivec2(0), sz - ivec2(1));
    return imageLoad(edgesImg, pos).x & 0x0Fu;
}

vec4 UnpackEdgesFlt(uint v) {
    return vec4(
        float((v & 0x01u) != 0u),
        float((v & 0x02u) != 0u),
        float((v & 0x04u) != 0u),
        float((v & 0x08u) != 0u));
}

// ---- RGB8 打包（输入 tonemap 后 LDR 0-1，显示精度即 rgba8888——8bit/通道无损且无浪费）----
// 官方用 R11G11B10 是为 HDR 输入（CMAA2_SUPPORT_HDR_COLOR_RANGE）；LDR 下 8bit 与显示精度一致
uint PackRGB8(vec3 c) {
    ivec3 q = ivec3(clamp(c, vec3(0.0), vec3(1.0)) * 255.0);
    return uint(q.r | (q.g << 8) | (q.b << 16));
}
vec3 UnpackRGB8(uint v) {
    return vec3(float(v & 0xFFu), float((v >> 8) & 0xFFu), float((v >> 16) & 0xFFu)) / 255.0;
}

// ---- StoreColorSample（2026-08-17 最终方案）：直接写 result 图（每候选 1 次随机写 4B）----
// 单 MSAA 每像素唯一候选 → 官方 apply 的 weight（0.8+isComplex）归一化抵消 → final = 混合色本身
// 同像素 Simple→Z 顺序调用（main 内），后写覆盖 = Z 优先（官方 weight 1.8 > 0.8 的近似）
void StoreColorSample(ivec2 pixelPos, vec3 color, bool isComplexShape) {
    imageStore(resultImg, pixelPos, vec4(color, 1.0));   // alpha=1 标记：此像素是 AA 结果
}

vec3 LoadColor(ivec2 p) {
    ivec2 sz = textureSize(colorTex, 0);
    p = clamp(p, ivec2(0), sz - ivec2(1));
    vec2 uv = (vec2(p) + 0.5) / vec2(sz);
    return textureLod(colorTex, uv, 0.0).rgb;
}

// ---- 官方 ComputeSimpleShapeBlendValues（dontTestShapeValidity=true 调用路径）----
vec4 ComputeSimpleShapeBlendValues(vec4 edges, vec4 edgesLeft, vec4 edgesRight, vec4 edgesTop, vec4 edgesBottom) {
    float fromRight = edges.r;
    float fromBelow = edges.g;
    float fromLeft  = edges.b;
    float fromAbove = edges.a;

    float blurCoeff = CMAA2_SIMPLE_SHAPE_BLURINESS;

    float numberOfEdges = dot(edges, vec4(1.0));
    float numberOfEdgesAllAround = dot(edgesLeft.bga + edgesRight.rga + edgesTop.rba + edgesBottom.rgb, vec3(1.0));

    // L-like step shape
    if (numberOfEdges == 2.0)
        blurCoeff *= 0.75;

    // k 修正（官方 #if 1 分支）
    float k = 0.9;
    fromRight += k * (edges.g * edgesTop.r     * (1.0 - edgesLeft.g)  + edges.a * edgesBottom.r   * (1.0 - edgesLeft.a));
    fromBelow += k * (edges.b * edgesRight.g   * (1.0 - edgesTop.b)   + edges.r * edgesLeft.g     * (1.0 - edgesTop.r));
    fromLeft  += k * (edges.a * edgesBottom.b  * (1.0 - edgesRight.a) + edges.g * edgesTop.b      * (1.0 - edgesRight.g));
    fromAbove += k * (edges.r * edgesLeft.a    * (1.0 - edgesBottom.r)+ edges.b * edgesRight.a    * (1.0 - edgesBottom.b));

    // 邻域边缘多时减弱混合（保文字/纹理细节）
    blurCoeff *= clamp(1.30 - numberOfEdgesAllAround / 10.0, 0.0, 1.0);

    return vec4(fromLeft, fromAbove, fromRight, fromBelow) * blurCoeff;
}

// ---- 官方 DetectZsHorizontal（水平）；垂直 = 输入旋转 .argb ----
void DetectZsHorizontal(vec4 edges, vec4 edgesM1P0, vec4 edgesP1P0, vec4 edgesP2P0,
                        out float invertedZScore, out float normalZScore) {
    // Inverted Z:
    //   __
    //  X|
    // --
    invertedZScore  = edges.r * edges.g * edgesP1P0.a;
    invertedZScore *= 2.0 + ((edgesM1P0.g + edgesP2P0.a)) - (edges.a + edgesP1P0.g)
                     - 0.7 * (edgesP2P0.g + edgesM1P0.a + edges.b + edgesP1P0.r);

    // Normal Z:
    // __
    //  X|
    //   --
    normalZScore    = edges.r * edges.a * edgesP1P0.g;
    normalZScore    *= 2.0 + ((edgesM1P0.a + edgesP2P0.g)) - (edges.g + edgesP1P0.a)
                     - 0.7 * (edgesP2P0.a + edgesM1P0.g + edges.b + edgesP1P0.r);
}

// ---- 官方 FindZLineLengths（全宽 LoadEdge）----
void FindZLineLengths(out float lineLengthLeft, out float lineLengthRight,
                      ivec2 screenPos, bool horizontal, bool invertedZShape, ivec2 stepRight) {
    uint maskTraceLeft, maskTraceRight;
    if (horizontal) {
        maskTraceLeft  = 0x08u;   // tracing top edge
        maskTraceRight = 0x02u;   // tracing bottom edge
    } else {
        maskTraceLeft  = 0x04u;   // tracing left edge
        maskTraceRight = 0x01u;   // tracing right edge
    }
    if (invertedZShape) {
        uint tmp = maskTraceLeft;
        maskTraceLeft = maskTraceRight;
        maskTraceRight = tmp;
    }
    uint maskLeft = maskTraceLeft;
    uint maskRight = maskTraceRight;

    bool continueLeft = true;
    bool continueRight = true;
    lineLengthLeft = 1.0;
    lineLengthRight = 1.0;

    for (;;) {
        uint edgeLeft  = LoadEdgePacked(screenPos - stepRight * int(lineLengthLeft));
        uint edgeRight = LoadEdgePacked(screenPos + stepRight * (int(lineLengthRight) + 1));

        continueLeft  = continueLeft  && ((edgeLeft  & maskLeft)  == maskTraceLeft);
        continueRight = continueRight && ((edgeRight & maskRight) == maskTraceRight);

        lineLengthLeft  += continueLeft ? 1.0 : 0.0;
        lineLengthRight += continueRight ? 1.0 : 0.0;

        float maxLR = max(lineLengthRight, lineLengthLeft);
        if (!continueLeft && !continueRight)
            maxLR = CMAA2_MAX_LINE_LENGTH;

        if (maxLR >= min(CMAA2_MAX_LINE_LENGTH, (1.25 * min(lineLengthRight, lineLengthLeft) - 0.25)))
            break;
    }
}

// ---- 官方 BlendZs（写 deferred list，isComplexShape=true）----
void BlendZs(ivec2 screenPos, bool horizontal, bool invertedZShape, float shapeQualityScore,
             float lineLengthLeft, float lineLengthRight, ivec2 stepRight) {
    ivec2 blendDir = horizontal ? ivec2(0, -1) : ivec2(-1, 0);
    if (invertedZShape)
        blendDir = -blendDir;

    float leftOdd  = CMAA2_SYMMETRY_CORRECTION_OFFSET * float(int(lineLengthLeft) % 2);
    float rightOdd = CMAA2_SYMMETRY_CORRECTION_OFFSET * float(int(lineLengthRight) % 2);

    float dampenEffect = clamp(float(lineLengthLeft + lineLengthRight - shapeQualityScore) * CMAA2_DAMPENING_EFFECT, 0.0, 1.0);

    float loopFrom = -floor((lineLengthLeft + 1.0) / 2.0) + 1.0;
    float loopTo   =  floor((lineLengthRight + 1.0) / 2.0);

    float totalLength = (loopTo - loopFrom) + 1.0 - leftOdd - rightOdd;
    float lerpStep = 1.0 / totalLength;

    float lerpFromK = (0.5 - leftOdd - loopFrom) * lerpStep;

    for (float i = loopFrom; i <= loopTo; i += 1.0) {
        float secondPart = (i > 0.0) ? 1.0 : 0.0;
        float srcOffset = 1.0 - secondPart * 2.0;

        float lerpK = (lerpStep * i + lerpFromK) * srcOffset + secondPart;
        lerpK *= dampenEffect;

        ivec2 pixelPos = screenPos + stepRight * int(i);
        vec3 colorCenter = LoadColor(pixelPos);
        vec3 colorFrom   = LoadColor(pixelPos + blendDir * int(srcOffset));
        vec3 mixedCol = mix(colorCenter, colorFrom, lerpK);   // HLSL lerp 语义（负值 = 外插，官方原样）
        StoreColorSample(pixelPos, mixedCol, true);
    }
}

// ---- 官方 ProcessCandidatesCS 主函数（单 MSAA、无 SLM/COLLECT 展开）----
void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= count) return;   // 固定 dispatch（cap/128 组）：count = 候选数（args 已弃用 2026-08-17）——early-out 尾组

    uint pixelID = data[idx];
    ivec2 pixelPos = ivec2(int(pixelID >> 18), int(pixelID & 0x3FFFu));

    vec4 edges       = UnpackEdgesFlt(LoadEdgePacked(pixelPos));
    vec4 edgesLeft   = UnpackEdgesFlt(LoadEdgePacked(pixelPos + ivec2(-1, 0)));
    vec4 edgesRight  = UnpackEdgesFlt(LoadEdgePacked(pixelPos + ivec2( 1, 0)));
    vec4 edgesBottom = UnpackEdgesFlt(LoadEdgePacked(pixelPos + ivec2( 0, 1)));
    vec4 edgesTop    = UnpackEdgesFlt(LoadEdgePacked(pixelPos + ivec2( 0, -1)));

    // Simple shapes：混合颜色 → deferred list
    {
        vec4 blendVal = ComputeSimpleShapeBlendValues(edges, edgesLeft, edgesRight, edgesTop, edgesBottom);
        float wSum = dot(blendVal, vec4(1.0));
        vec3 outColor = LoadColor(pixelPos) * (1.0 - wSum);
        if (blendVal.x > 0.0) outColor += blendVal.x * LoadColor(pixelPos + ivec2(-1, 0));
        if (blendVal.y > 0.0) outColor += blendVal.y * LoadColor(pixelPos + ivec2( 0, -1));
        if (blendVal.z > 0.0) outColor += blendVal.z * LoadColor(pixelPos + ivec2( 1, 0));
        if (blendVal.w > 0.0) outColor += blendVal.w * LoadColor(pixelPos + ivec2( 0, 1));
        StoreColorSample(pixelPos, outColor, false);
    }

    // Complex shapes（Z）：检测 → 线长 → 混合颜色 → deferred list
    {
        float invertedZScore, normalZScore;
        float maxScore;
        bool horizontal = true;
        bool invertedZ = false;

        // horizontal
        {
            vec4 edgesM1P0 = edgesLeft;
            vec4 edgesP1P0 = edgesRight;
            vec4 edgesP2P0 = UnpackEdgesFlt(LoadEdgePacked(pixelPos + ivec2( 2, 0)));

            DetectZsHorizontal(edges, edgesM1P0, edgesP1P0, edgesP2P0, invertedZScore, normalZScore);
            maxScore = max(invertedZScore, normalZScore);
            if (maxScore > 0.0)
                invertedZ = invertedZScore > normalZScore;
        }

        // vertical（输入旋转 .argb：left→bottom、top→left、right→top、bottom→right）
        {
            vec4 edgesM1P0 = edgesBottom;
            vec4 edgesP1P0 = edgesTop;
            vec4 edgesP2P0 = UnpackEdgesFlt(LoadEdgePacked(pixelPos + ivec2(0, -2)));

            DetectZsHorizontal(edges.argb, edgesM1P0.argb, edgesP1P0.argb, edgesP2P0.argb, invertedZScore, normalZScore);
            float vertScore = max(invertedZScore, normalZScore);
            if (vertScore > maxScore) {
                maxScore = vertScore;
                horizontal = false;
                invertedZ = invertedZScore > normalZScore;
            }
        }

        if (maxScore > 0.0) {
            float shapeQualityScore = floor(clamp(4.0 - maxScore, 0.0, 3.0));

            ivec2 stepRight = horizontal ? ivec2(1, 0) : ivec2(0, -1);
            float lineLengthLeft, lineLengthRight;
            FindZLineLengths(lineLengthLeft, lineLengthRight, pixelPos, horizontal, invertedZ, stepRight);

            lineLengthLeft  -= shapeQualityScore;
            lineLengthRight -= shapeQualityScore;

            if ((lineLengthLeft + lineLengthRight) >= 5.0) {
                BlendZs(pixelPos, horizontal, invertedZ, shapeQualityScore,
                        lineLengthLeft, lineLengthRight, stepRight);
            }
        }
    }
}
