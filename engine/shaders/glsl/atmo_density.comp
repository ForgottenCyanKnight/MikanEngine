#version 450
#extension GL_GOOGLE_include_directive : require
// atmo_density.comp — 第 n 阶散射密度（512 方向积分，含相函数）
// 严格 n-1 阶入射场（2026-08-11）：order==1 用单次散射 LUT（combined 除相函数 × 相函数还原）、
//   order>=2 用 deltaMultiLUT（纯上一阶多次散射，含相函数存储直接查）
// 地面反弹用 deltaIrrLUT（纯上一阶辐照度，官方 delta_irradiance 语义）
// 输出 densityLUT（3D，每阶覆盖）
#include "atmo_common.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 4) in;

layout(set = 0, binding = 0, rgba32f) uniform writeonly image3D densityLUT;
layout(set = 0, binding = 1) uniform sampler3D singleScatLUT;      // 单次散射（combined；order==1 入射场）
layout(set = 0, binding = 2) uniform sampler2D transmittanceLUT;
layout(set = 0, binding = 3) uniform sampler2D deltaIrrLUT;        // 上一阶间接辐照度（地面反弹）
layout(set = 0, binding = 4) uniform sampler3D deltaMultiLUT;      // 上一阶纯多次散射（含相函数；order>=2 入射场）

layout(push_constant) uniform PC { int order; } pc;   // C++ 传 n-1（n=散射阶 2..N）

void main() {
    ivec3 px = ivec3(gl_GlobalInvocationID.xyz);
    if (px.x >= SCATTERING_TEXTURE_WIDTH || px.y >= SCATTERING_TEXTURE_HEIGHT ||
        px.z >= SCATTERING_TEXTURE_DEPTH) return;

    vec3 fragCoord = vec3(px) + 0.5;
    float r, mu, mu_s, nu;
    bool rayIntersectsGround;
    GetRMuMuSNuFromScatteringTextureFragCoord(fragCoord, r, mu, mu_s, nu, rayIntersectsGround);

    vec3 density = ComputeScatteringDensity(transmittanceLUT, singleScatLUT, deltaMultiLUT,
                                            deltaIrrLUT, r, mu, mu_s, nu, pc.order);
    imageStore(densityLUT, px, vec4(density, 1.0));
}
