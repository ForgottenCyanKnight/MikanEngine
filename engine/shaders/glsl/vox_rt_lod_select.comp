#version 450
layout(local_size_x=64) in;
struct Choice {vec4 center;uvec4 hit;uvec4 low;uvec4 high;uvec4 options;};
layout(std430,binding=0) buffer Choices {Choice choices[];};
layout(std430,binding=1) buffer Instances {uint words[];};
layout(push_constant) uniform Push {vec4 camera;vec4 distances;uint count;int forceLevel;} pc;
void main(){
    uint i=gl_GlobalInvocationID.x;if(i>=pc.count)return;
    Choice c=choices[i];uint base=c.options.x*16u;
    vec4 p=vec4(c.center.xyz,1);
    vec3 center=vec3(dot(uintBitsToFloat(uvec4(words[base],words[base+1],words[base+2],words[base+3])),p),
        dot(uintBitsToFloat(uvec4(words[base+4],words[base+5],words[base+6],words[base+7])),p),
        dot(uintBitsToFloat(uvec4(words[base+8],words[base+9],words[base+10],words[base+11])),p));
    float d=distance(pc.camera.xyz,center);
    uint maxLevel=min(uint(pc.distances.w),1u);
    uint previous=min(c.options.z,maxLevel),level=previous;
    if(pc.forceLevel>=0)level=min(uint(pc.forceLevel),maxLevel);
    else{
        while(level<maxLevel&&d>pc.distances[level]*(previous>0u?1.1:1.0))++level;
        while(level>0u&&d<pc.distances[level-1u]*.9)--level;
    }
    // LOD0 and LOD1 are valid active BLASes, including exact-geometry fallback.
    // Instance count/activity remain constant, permitting an in-place TLAS UPDATE.
    words[base+12u]=c.hit[level]|(c.options.y<<24u);
    words[base+14u]=c.low[level];words[base+15u]=c.high[level];
    choices[i].options.z=level;
}
