#version 450

layout(local_size_x = 64) in;

// 相机数据
layout(std140, binding = 0) uniform CameraData {
    uint totalFaceCommands;
    uint enableHiZCulling;
    uint screenWidth;
    uint screenHeight;
    vec4 frustumPlanes[6];
    vec4 viewPos;
    mat4 viewProj;
    mat4 prevViewProj;  // 上一帧的视图投影矩阵
} camera;

// 绘制命令输入缓冲区
layout(std430, binding = 1) buffer InputBuffer {
    uint data[];
} inputBuffer;

// 绘制命令输出缓冲区
layout(std430, binding = 2) buffer OutputBuffer {
    uint data[];
} outputBuffer;

// 实例数据缓冲区
layout(std430, binding = 3) buffer InstanceDataBuffer {
    float instanceData[];
} instanceData;

// Hi-Z 深度金字塔纹理
layout(binding = 4) uniform sampler2D HiZTexture;

vec2 ndcToUV(vec2 ndc) {
    // 注意：投影矩阵已经使用 proj[1][1] *= -1 翻转了Y轴
    // 所以NDC的y轴已经是正确的，不需要再次翻转
    return vec2(ndc.x * 0.5 + 0.5, ndc.y * 0.5 + 0.5);
}

int getMipLevel(vec2 uvMin, vec2 uvMax) {
    // 使用与IDKEngine相同的mip层级计算方法
    vec2 size = (uvMax - uvMin) * vec2(camera.screenWidth, camera.screenHeight);
    float maxSize = max(size.x, size.y);
    if (maxSize <= 0.0) {
        return 0;
    }
    // CeilLog2: 计算大于等于maxSize的最小2的幂次的指数
    return int(clamp(ceil(log2(maxSize)), 0.0, 10.0));
}

bool hiZTest(vec3 minPos, vec3 maxPos) {
    vec3 corners[8];
    corners[0] = vec3(minPos.x, minPos.y, minPos.z);
    corners[1] = vec3(maxPos.x, minPos.y, minPos.z);
    corners[2] = vec3(minPos.x, maxPos.y, minPos.z);
    corners[3] = vec3(maxPos.x, maxPos.y, minPos.z);
    corners[4] = vec3(minPos.x, minPos.y, maxPos.z);
    corners[5] = vec3(maxPos.x, minPos.y, maxPos.z);
    corners[6] = vec3(minPos.x, maxPos.y, maxPos.z);
    corners[7] = vec3(maxPos.x, maxPos.y, maxPos.z);

    vec3 ndcMin = vec3(1.0);
    vec3 ndcMax = vec3(-1.0);
    bool behindCamera = false;

    for (int i = 0; i < 8; i++) {
        vec4 clipPos = camera.prevViewProj * vec4(corners[i], 1.0);

        if (clipPos.w <= 0.0) {
            behindCamera = true;
            continue;
        }

        vec3 ndc = clipPos.xyz / clipPos.w;
        ndcMin = min(ndcMin, ndc);
        ndcMax = max(ndcMax, ndc);
    }

    if (behindCamera && ndcMin.x >= 1.0 && ndcMin.y >= 1.0 && ndcMin.z >= 1.0) {
        return false;
    }

    vec2 uvMin = clamp(ndcToUV(ndcMin.xy), vec2(0.0), vec2(1.0));
    vec2 uvMax = clamp(ndcToUV(ndcMax.xy), vec2(0.0), vec2(1.0));

    int mipLevel = getMipLevel(uvMin, uvMax);

    // 将NDC深度转换为[0, 1]范围
    // 注意：NDC的z值范围通常是[-1, 1]，转换后近平面为0，远平面为1
    float depthMin = ndcMin.z * 0.5 + 0.5;
    float depthMax = ndcMax.z * 0.5 + 0.5;

    // 采样HiZ纹理的四个角
    float hizDepth = textureLod(HiZTexture, uvMin, mipLevel).r;
    float hizDepth2 = textureLod(HiZTexture, vec2(uvMax.x, uvMin.y), mipLevel).r;
    float hizDepth3 = textureLod(HiZTexture, vec2(uvMin.x, uvMax.y), mipLevel).r;
    float hizDepth4 = textureLod(HiZTexture, uvMax, mipLevel).r;

    // 获取HiZ中采样点的最大深度（最远距离）
    // HiZ纹理存储的是每个区域的最大深度值
    float furthestDepth = max(max(hizDepth, hizDepth2), max(hizDepth3, hizDepth4));

    // 遮挡判断：如果vox的最近点 >= HiZ中的最大深度，则vox被完全遮挡
    // 也就是说，如果vox的所有点都在HiZ记录的最远点之后，那么vox被遮挡
    if (depthMin >= furthestDepth) {
        return false;
    }

    return true;
}

void main() {
    uint idx = gl_GlobalInvocationID.x;

    if (idx >= camera.totalFaceCommands) {
        return;
    }

    uint baseIdx = idx * 8;

    uint indexCount = inputBuffer.data[baseIdx + 0];
    uint instanceCount = inputBuffer.data[baseIdx + 1];
    uint firstIndex = inputBuffer.data[baseIdx + 2];
    int vertexOffset = int(inputBuffer.data[baseIdx + 3]);
    uint firstInstance = inputBuffer.data[baseIdx + 4];
    uint faceDirection = inputBuffer.data[baseIdx + 5];
    uint enabled = inputBuffer.data[baseIdx + 6];
    uint padding = inputBuffer.data[baseIdx + 7];

    if (enabled == 0 || indexCount == 0 || instanceCount == 0) {
        indexCount = 0;
        instanceCount = 0;
    } else if (camera.enableHiZCulling != 0) {
        uint instanceDataIdx = firstInstance * 6;
        vec3 minPos = vec3(
            instanceData.instanceData[instanceDataIdx + 0],
            instanceData.instanceData[instanceDataIdx + 1],
            instanceData.instanceData[instanceDataIdx + 2]
        );
        vec3 maxPos = vec3(
            instanceData.instanceData[instanceDataIdx + 3],
            instanceData.instanceData[instanceDataIdx + 4],
            instanceData.instanceData[instanceDataIdx + 5]
        );

        if (!hiZTest(minPos, maxPos)) {
            indexCount = 0;
            instanceCount = 0;
        }
    }

    outputBuffer.data[baseIdx + 0] = indexCount;
    outputBuffer.data[baseIdx + 1] = instanceCount;
    outputBuffer.data[baseIdx + 2] = firstIndex;
    outputBuffer.data[baseIdx + 3] = uint(vertexOffset);
    outputBuffer.data[baseIdx + 4] = firstInstance;
    outputBuffer.data[baseIdx + 5] = faceDirection;
    outputBuffer.data[baseIdx + 6] = enabled;
    outputBuffer.data[baseIdx + 7] = padding;
}
