    float dyp=texelFetch(rasterDepth,yp,0).r,dym=texelFetch(rasterDepth,ym,0).r;
    vec3 dx=abs(dxp-depth)<abs(dxm-depth)?rasterWorldPosition(xp,dxp)-surface.position:surface.position-rasterWorldPosition(xm,dxm);
    vec3 dy=abs(dyp-depth)<abs(dym-depth)?rasterWorldPosition(yp,dyp)-surface.position:surface.position-rasterWorldPosition(ym,dym);
    vec3 geometric=cross(dx,dy);geometric=dot(geometric,geometric)>1e-16?normalize(geometric):normal;
    if(dot(geometric,direction)>0.0)geometric=-geometric;
