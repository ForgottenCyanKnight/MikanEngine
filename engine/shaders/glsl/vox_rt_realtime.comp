    // previous XY at the previous view depth (static imported model contract).
    vec2 motion=texelFetch(rasterMotion,p,0).xy;
    float previousDepth=abs((temporal.previousView*vec4(surface.position,1)).z);
    vec2 previousUV=(vec2(p)+.5)/pc.extent.xy+temporal.jitter.xy-motion;
    vec4 previousNear=inverse(temporal.previousViewProjection)*vec4(previousUV*2.0-1.0,0,1);
    vec4 previousFar=inverse(temporal.previousViewProjection)*vec4(previousUV*2.0-1.0,1,1);
