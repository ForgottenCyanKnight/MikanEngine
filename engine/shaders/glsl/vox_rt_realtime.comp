// Tail records are allocated only for the diagnostic variant, after all pixel hits.
// Categories: 0 primary surface, 1 secondary surface, 2 shadow visibility.
void recordQuadQuery(uint category,uint candidates,uint accepted){
    if(!quadQueryStats)return;
    uint base=uint(pc.extent.x)*uint(pc.extent.y);
    atomicAdd(primaryHits[base+category].instancePlusOne,1u);
    atomicAdd(primaryHits[base+category].geometry,candidates);
    atomicAdd(primaryHits[base+category].primitive,accepted);
    atomicMax(primaryHits[base+3u+category].instancePlusOne,candidates);
    atomicAdd(primaryHits[base+3u+category].geometry,uint(candidates>0u));
}
uvec2 hardwareQuadData(uint instanceIndex,uint geometry,uint quad){
    Instance instance=instances[instanceIndex];uvec4 range=ranges[instance.info.x+geometry];
    uvec4 header=ranges[instance.info.w+1u];uint q=range.x+quad-header.y;
    uvec4 pair=ranges[header.x+q/2u];return (q&1u)==0u?pair.xy:pair.zw;
}
// Object rays are not normalized: t remains in world-ray units under instance scaling.
bool intersectHardwareQuad(uint index,uint geometry,uint quad,vec3 o,vec3 d,bool cameraRay,out float t,out vec2 uv){
    Instance instance=instances[index];if(instance.info.z==1u)return false;
    uvec4 range=ranges[instance.info.x+geometry];uint face=range.z;
    vec4 grid=uintBitsToFloat(ranges[instance.info.w]);o=(o-grid.xyz)/grid.w;d/=grid.w;
    uvec2 decoded=hardwareQuadData(index,geometry,quad);uint g=decoded.x,a=decoded.y;
    vec3 start=vec3(g&255u,(g>>8)&255u,(g>>16)&255u);
    int axis=face<2u?2:(face<4u?0:1),u=face<2u?0:(face<4u?2:0),v=face<4u?1:2;
    float outward=(face==0u||face==3u||face==4u)?1.0:-1.0;
    if(abs(d[axis])<1e-20||(cameraRay&&d[axis]*outward>=0.0))return false;
    float plane=start[axis]+(outward>0.0?1.0:0.0);t=(plane-o[axis])/d[axis];
    vec3 point=o+d*t;uv=(vec2(point[u],point[v])-vec2(start[u],start[v]))/vec2((g>>24)+1u,(a&255u)+1u);
    return t>=.001&&all(greaterThanEqual(uv,vec2(0)))&&all(lessThanEqual(uv,vec2(1)));
}
// Per invocation: only reflection paths force MASK geometry opaque.
bool reflectionOpaque=false;
bool traceOccluded(vec3 origin,vec3 direction,float limit,uint mask){
    if(softwareQuadBvh)return traceSoftwareQuads(origin,direction,limit,mask,true,false).hit;
    uint candidates=0u,accepted=0u;
    uint flags=gl_RayFlagsTerminateOnFirstHitEXT|(reflectionOpaque?gl_RayFlagsOpaqueEXT:0u);
    rayQueryEXT ray;rayQueryInitializeEXT(ray,scene,flags,mask,origin,.001,direction,limit);
    while(rayQueryProceedEXT(ray)){
        if(hardwareQuadAabb&&rayQueryGetIntersectionTypeEXT(ray,false)==gl_RayQueryCandidateIntersectionAABBEXT){
            if(quadQueryStats)++candidates;float t;vec2 uv;
            if(intersectHardwareQuad(rayQueryGetIntersectionInstanceCustomIndexEXT(ray,false),rayQueryGetIntersectionGeometryIndexEXT(ray,false),
                rayQueryGetIntersectionPrimitiveIndexEXT(ray,false),rayQueryGetIntersectionObjectRayOriginEXT(ray,false),
                rayQueryGetIntersectionObjectRayDirectionEXT(ray,false),false,t,uv)&&t<=limit){rayQueryGenerateIntersectionEXT(ray,t);if(quadQueryStats)++accepted;}
        }else if(rayQueryGetIntersectionTypeEXT(ray,false)==gl_RayQueryCandidateIntersectionTriangleEXT &&
           acceptModelAlpha(rayQueryGetIntersectionInstanceCustomIndexEXT(ray,false),
               rayQueryGetIntersectionPrimitiveIndexEXT(ray,false),rayQueryGetIntersectionBarycentricsEXT(ray,false),rayQueryGetIntersectionGeometryIndexEXT(ray,false))){
            rayQueryConfirmIntersectionEXT(ray);
