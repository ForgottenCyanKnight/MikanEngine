// Mask bit 8 marks transparent (refractive) geometry. Camera rays and
// refraction continuations trace with 1|8; shadow (2) and GI (1) rays pass
// through glass. Opaque instances keep mask 1, metadata-only meshes 4.
bool traceSurface(vec3 origin,vec3 direction,float distanceLimit,out Surface surface,bool cameraRay){
    return traceSurface(origin,direction,distanceLimit,surface,cameraRay,cameraRay?8u:0u);
}
bool traceSurface(vec3 origin,vec3 direction,float distanceLimit,out Surface surface){
    return traceSurface(origin,direction,distanceLimit,surface,false);
}
// Refraction continuations keep seeing glass (mask 1|8) without the camera-ray
// side effects (MASK alpha confirmation and primary-hit record).
bool traceWithGlass(vec3 origin,vec3 direction,float distanceLimit,out Surface surface){
    return traceSurface(origin,direction,distanceLimit,surface,false,8u);
}
bool loadPrimarySurface(vec3 origin,vec3 direction,out Surface surface){
    uint pixel=rtPixel.y*uint(pc.extent.x)+rtPixel.x;
    PrimaryHit hit=primaryHits[pixel];if(hit.instancePlusOne==0u)return false;
    uint index=hit.instancePlusOne-1u;
    return decodeSurface(index,hit.geometry,hit.primitive,hit.bary,mat4x3(primaryTransforms[index]),origin,direction,hit.hitT,surface);
}

bool loadRasterSurface(ivec2 p,vec3 direction,out Surface surface);
bool surfaceAtPixel(ivec2 pixel,out Surface surface){
    if(any(lessThan(pixel,ivec2(0)))||any(greaterThanEqual(pixel,ivec2(pc.extent.xy))))return false;
    if(primarySunMode>=3u)return loadRasterSurface(pixel,normalize((pc.inverseViewProj*vec4((vec2(pixel)+.5)/pc.extent.xy*2.0-1.0,1,1)).xyz / (pc.inverseViewProj*vec4((vec2(pixel)+.5)/pc.extent.xy*2.0-1.0,1,1)).w-pc.eye.xyz),surface);
    PrimaryHit hit=primaryHits[uint(pixel.y)*uint(pc.extent.x)+uint(pixel.x)];
    if(hit.instancePlusOne==0u)return false;
    vec2 uv=(vec2(pixel)+.5)/pc.extent.xy*2.0-1.0;
    vec4 a=pc.inverseViewProj*vec4(uv,0,1),b=pc.inverseViewProj*vec4(uv,1,1);a/=a.w;b/=b.w;
    uint index=hit.instancePlusOne-1u;
    return decodeSurface(index,hit.geometry,hit.primitive,hit.bary,mat4x3(primaryTransforms[index]),a.xyz,normalize(b.xyz-a.xyz),hit.hitT,surface);
}

