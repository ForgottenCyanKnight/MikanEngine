// Diagnostic bridge for the current octahedral normal/material MRT contract.
vec3 rasterWorldPosition(ivec2 p,float depth){
    vec2 ndc=(vec2(p)+.5)/pc.extent.xy*2.0-1.0;
    vec4 world=pc.inverseViewProj*vec4(ndc,depth,1);return world.xyz/world.w;
}
bool loadRasterSurface(ivec2 p,vec3 direction,out Surface surface){
    float depth=texelFetch(rasterDepth,p,0).r;if(depth>=1.0)return false;
    vec4 albedo=texelFetch(rasterAlbedo,p,0),material=texelFetch(rasterMaterial,p,0);
    vec2 oct=texelFetch(rasterNormal,p,0).rg;
