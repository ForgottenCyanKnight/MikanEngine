    surface.normal=normalize(normalMatrix*localNormal);surface.geometricNormal=normalize(normalMatrix*localGeometricNormal);
    if(instance.info.z==1u)surface.normal=modelMappedWorldNormal(instance.info.x,primitive,bary,normalMatrix,surface.normal,(instance.info.y&8u)!=0u);
    // Orient by the actual face; do not independently flip normal-map detail.
    if(dot(surface.geometricNormal,direction)>0){surface.geometricNormal=-surface.geometricNormal;surface.normal=-surface.normal;}
    if(instance.info.z==1u){
        vec2 hair=unpackHalf2x16(floatBitsToUint(modelGeometries[instance.info.x].emission.w));
        surface.anisotropy=hair.x;surface.hairShift=hair.y;
        if(abs(surface.anisotropy)>1e-4){
