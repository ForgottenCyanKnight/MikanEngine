        if(modelPreviousSurface(instance.info.x,primitive,bary,previousLocalPosition,previousLocalNormal)){
            surface.previousPosition=(previousFromCurrent[index]*vec4(model*vec4(previousLocalPosition,1),1)).xyz;
            surface.previousNormal=normalize(transpose(inverse(mat3(previousFromCurrent[index])))*normalMatrix*previousLocalNormal);
