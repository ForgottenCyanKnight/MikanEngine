bool traceSurface(vec3 origin,vec3 direction,float distanceLimit,out Surface surface,bool cameraRay,uint extraMask){
    if(softwareQuadBvh){
        SoftwareHit hit=traceSoftwareQuads(origin,direction,distanceLimit,1u,false,cameraRay);if(!hit.hit)return false;
        if(rtStage()>.5){uint pixel=rtPixel.y*uint(pc.extent.x)+rtPixel.x;primaryHits[pixel]=PrimaryHit(hit.instance+1u,hit.geometry,hit.primitive,hit.t,hit.bary);atomicOr(tileHasHit,1u);}
        return decodeSurface(hit.instance,hit.geometry,hit.primitive,hit.bary,mat4x3(primaryTransforms[hit.instance]),origin,direction,hit.t,surface);
    }
    uint candidates=0u,accepted=0u;vec2 generatedUV=vec2(0);uint generatedFace=0u;
    // Opaque geometry commits in hardware. Only MASK instances override their
    // BLAS opacity and yield candidates for every ray category.
    uint flags=reflectionOpaque?gl_RayFlagsOpaqueEXT:0u;
    rayQueryEXT ray;rayQueryInitializeEXT(ray,scene,flags,(cameraRay||extraMask!=0u)?13u:1u,origin,.001,direction,distanceLimit);
    while(rayQueryProceedEXT(ray)){
        if(hardwareQuadAabb&&rayQueryGetIntersectionTypeEXT(ray,false)==gl_RayQueryCandidateIntersectionAABBEXT){
            if(quadQueryStats)++candidates;float t;vec2 uv;
            float nearest=rayQueryGetIntersectionTypeEXT(ray,true)==gl_RayQueryCommittedIntersectionNoneEXT?distanceLimit:rayQueryGetIntersectionTEXT(ray,true);
            if(intersectHardwareQuad(rayQueryGetIntersectionInstanceCustomIndexEXT(ray,false),rayQueryGetIntersectionGeometryIndexEXT(ray,false),
                rayQueryGetIntersectionPrimitiveIndexEXT(ray,false),rayQueryGetIntersectionObjectRayOriginEXT(ray,false),
                rayQueryGetIntersectionObjectRayDirectionEXT(ray,false),cameraRay,t,uv)&&t<nearest){
                generatedUV=uv;
                uint candidateIndex=rayQueryGetIntersectionInstanceCustomIndexEXT(ray,false);
                generatedFace=ranges[instances[candidateIndex].info.x+rayQueryGetIntersectionGeometryIndexEXT(ray,false)].z;
                rayQueryGenerateIntersectionEXT(ray,t);
                if(quadQueryStats)++accepted;
            }
        }
        // MASK candidates retain the same alpha test for all ray categories.
        // Instance facing-cull disable still accepts both triangle sides.
        if(rayQueryGetIntersectionTypeEXT(ray,false)==gl_RayQueryCandidateIntersectionTriangleEXT){
            const uint ci=rayQueryGetIntersectionInstanceCustomIndexEXT(ray,false);
            bool accept=acceptModelAlpha(ci,rayQueryGetIntersectionPrimitiveIndexEXT(ray,false),
                rayQueryGetIntersectionBarycentricsEXT(ray,false),rayQueryGetIntersectionGeometryIndexEXT(ray,false));
            if(accept)rayQueryConfirmIntersectionEXT(ray);
        }
    }
    recordQuadQuery(cameraRay?0u:1u,candidates,accepted);
    uint committed=rayQueryGetIntersectionTypeEXT(ray,true);
    bool triangle=committed!=gl_RayQueryCommittedIntersectionNoneEXT;
    float closest=triangle?rayQueryGetIntersectionTEXT(ray,true):distanceLimit;
    DdaHit dda=traceVoxelDDA(origin,direction,closest,1u,cameraRay);
    if(!triangle&&!dda.hit)return false;
    uint index,geometry,primitive;vec2 bary;float hitT;mat4x3 model;
    if(dda.hit){index=dda.index;geometry=0x80000000u|dda.record;primitive=dda.voxel;bary=vec2(float(dda.face),0);hitT=dda.t;model=mat4x3(1);}
    else{index=rayQueryGetIntersectionInstanceCustomIndexEXT(ray,true);geometry=rayQueryGetIntersectionGeometryIndexEXT(ray,true);
        primitive=rayQueryGetIntersectionPrimitiveIndexEXT(ray,true);hitT=closest;model=rayQueryGetIntersectionObjectToWorldEXT(ray,true);
        if(hardwareQuadAabb&&instances[index].info.z!=1u){
            // The last generated hit is the nearest accepted procedural hit.
            // Preserve its exact rectangle UV instead of decoding and inverting again.
            vec2 uv=generatedUV;uint face=generatedFace;
            uint halfId=face==0u?uint(uv.y>uv.x):(face==2u?uint(uv.x+uv.y<1.0):(face==5u?uint(uv.x+uv.y>1.0):uint(uv.x>uv.y)));
