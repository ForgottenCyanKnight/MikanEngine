#version 450
layout(local_size_x=8,local_size_y=8) in;
layout(binding=0) uniform sampler2D packedTex;
layout(binding=1,rgba16f) writeonly uniform image2D resultImage;
void main() {
    ivec2 p=ivec2(gl_GlobalInvocationID.xy);
    if(any(greaterThanEqual(p,imageSize(resultImage)))) return;
    vec4 c=texelFetch(packedTex,p,0);
    float t=c.x-c.z;
    // REBLUR_BackEnd_UnpackRadianceAndNormHitDist (NRD.hlsli).
    imageStore(resultImage,p,vec4(max(vec3(t+c.y,c.x+c.z,t-c.y),vec3(0)),c.a));
}
