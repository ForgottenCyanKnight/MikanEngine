#version 450

// Terrain 4x4-tile GPU culling.  The CPU first compacts frustum/distance
// candidates and keeps the LOD/stitching decision stable for this frame; this
// pass performs the fine AABB test and writes instanceCount for the three LOD
// command segments.

layout(local_size_x = 64) in;

struct TerrainMdiTileGpu {
    vec4 minBounds; // world-space AABB min.xyz
    vec4 maxBounds; // world-space AABB max.xyz
    uvec4 params;    // x = selected LOD (CPU candidates are 0..2)
};

layout(set = 0, binding = 0) readonly buffer TileBuf {
    TerrainMdiTileGpu tiles[];
};

// VkDrawIndexedIndirectCommand = 5 uint / 20 bytes.  The CPU initializes
// indexCount/firstIndex/vertexOffset/firstInstance; this pass updates only
// instanceCount, so the command remains valid for vkCmdDrawIndexedIndirect.
layout(set = 0, binding = 1) buffer CommandBuf {
    uint commands[];
};

// 上一帧 GameView 的 Hi-Z 深度金字塔。mip0 对应原始深度的 mip1，
// 因此只在引擎报告有有效上一帧数据时启用。
layout(set = 0, binding = 2) uniform sampler2D HiZTexture;

struct TerrainMdiCullViewGpu {
    mat4 hizViewProj;
    uvec4 hizParams; // x = screen width, y = height, z = culling mip count, w = enabled
};
layout(std140, set = 0, binding = 3) uniform ViewBuf {
    TerrainMdiCullViewGpu views[2];
} viewBuf;

// 6 * vec4 + vec4 + uvec4 = 128 bytes.
layout(push_constant) uniform TerrainMdiCullPush {
    vec4 planes[6];
    vec4 cameraPosDist;
    uvec4 params; // x = candidate count, y = view slot, z = segment capacity, w = tile base
} pc;

bool HiZOccluded(vec3 bmin, vec3 bmax, TerrainMdiCullViewGpu viewData) {
    if (viewData.hizParams.w == 0u || viewData.hizParams.z == 0u) {
        return false;
    }

    vec2 ndcMin = vec2(1.0);
    vec2 ndcMax = vec2(-1.0);
    float ndcMinDepth = 1.0;
    float ndcMaxDepth = 0.0;
    float nearestDepth = 1.0;
    bool anyProjected = false;

    for (uint corner = 0u; corner < 8u; ++corner) {
        vec3 p = vec3(
            (corner & 1u) != 0u ? bmax.x : bmin.x,
            (corner & 2u) != 0u ? bmax.y : bmin.y,
            (corner & 4u) != 0u ? bmax.z : bmin.z);
        vec4 clip = viewData.hizViewProj * vec4(p, 1.0);
        if (clip.w <= 0.0001) {
            // A box crossing the previous camera plane cannot be conservatively
            // tested from this projection.
            return false;
        }
        vec3 ndc = clip.xyz / clip.w;
        ndcMin = min(ndcMin, ndc.xy);
        ndcMax = max(ndcMax, ndc.xy);
        // The engine's depth attachment is Vulkan's [0, 1] depth value.  Do
        // not apply the OpenGL [-1, 1] -> [0, 1] remap here: the value written
        // by the rasterizer and the value reduced into Hi-Z are both ndc.z.
        float depth01 = clamp(ndc.z, 0.0, 1.0);
        ndcMinDepth = min(ndcMinDepth, depth01);
        ndcMaxDepth = max(ndcMaxDepth, depth01);
        nearestDepth = min(nearestDepth, depth01);
        anyProjected = true;
    }

    if (!anyProjected || ndcMax.x < -1.0 || ndcMin.x > 1.0 ||
        ndcMax.y < -1.0 || ndcMin.y > 1.0 ||
        ndcMaxDepth <= 0.0 || ndcMinDepth >= 1.0) {
        return false;
    }

    vec2 uvMin = clamp(ndcMin * 0.5 + 0.5, vec2(0.0), vec2(1.0));
    vec2 uvMax = clamp(ndcMax * 0.5 + 0.5, vec2(0.0), vec2(1.0));
    vec2 pixelExtent = (uvMax - uvMin) * vec2(viewData.hizParams.xy);
    float footprint = max(pixelExtent.x, pixelExtent.y);
    int mip = int(max(0.0, floor(log2(max(footprint, 1.0))))) - 1;
    mip = clamp(mip, 0, int(viewData.hizParams.z) - 1);

    ivec2 mipSize = textureSize(HiZTexture, mip);
    ivec2 pMin = clamp(ivec2(floor(uvMin * vec2(mipSize))), ivec2(0), mipSize - 1);
    ivec2 pMax = clamp(ivec2(ceil(uvMax * vec2(mipSize)) - 1.0), ivec2(0), mipSize - 1);
    float hizDepth = max(
        max(texelFetch(HiZTexture, ivec2(pMin.x, pMin.y), mip).r,
            texelFetch(HiZTexture, ivec2(pMax.x, pMin.y), mip).r),
        max(texelFetch(HiZTexture, ivec2(pMin.x, pMax.y), mip).r,
            texelFetch(HiZTexture, ivec2(pMax.x, pMax.y), mip).r));
    hizDepth = clamp(hizDepth, 0.0, 1.0);

    // 标准 Vulkan [0,1] 深度：候选 AABB 最近点仍在 Hi-Z 最远深度之后，
    // 才能判定整块被遮挡。留一个小 epsilon 抑制深度量化边界误杀。
    return nearestDepth > hizDepth + 0.0015;
}

void main() {
    uint tileIndex = gl_GlobalInvocationID.x;
    if (tileIndex >= pc.params.x) {
        return;
    }

    uint tileBase = pc.params.w;
    vec3 bmin = tiles[tileBase + tileIndex].minBounds.xyz;
    vec3 bmax = tiles[tileBase + tileIndex].maxBounds.xyz;
    uint selectedLod = tiles[tileBase + tileIndex].params.x;
    bool visible = selectedLod < 3u;

    if (visible) {
        for (int p = 0; p < 6; ++p) {
            vec3 n = pc.planes[p].xyz;
            vec3 pVertex = vec3(n.x >= 0.0 ? bmax.x : bmin.x,
                                n.y >= 0.0 ? bmax.y : bmin.y,
                                n.z >= 0.0 ? bmax.z : bmin.z);
            if (dot(n, pVertex) + pc.planes[p].w < 0.0) {
                visible = false;
                break;
            }
        }
    }

    if (visible && pc.cameraPosDist.w > 0.0) {
        vec2 camXZ = pc.cameraPosDist.xz;
        vec2 closest = clamp(camXZ, bmin.xz, bmax.xz);
        float tileRadius = 0.5 * length(bmax.xz - bmin.xz);
        if (distance(camXZ, closest) > pc.cameraPosDist.w + tileRadius) {
            visible = false;
        }
    }

    if (visible) {
        visible = !HiZOccluded(bmin, bmax, viewBuf.views[pc.params.y]);
    }

    for (uint lod = 0u; lod < 3u; ++lod) {
        uint commandIndex = (pc.params.y * 3u + lod) * pc.params.z + tileIndex;
        uint commandBase = commandIndex * 5u;
        commands[commandBase + 1u] = (visible && selectedLod == lod) ? 1u : 0u;
    }
}
