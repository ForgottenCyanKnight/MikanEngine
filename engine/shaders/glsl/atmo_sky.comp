#version 450
#extension GL_GOOGLE_include_directive : require
// atmo_sky.comp — 低分辨率天空全景图生成（compute 版 skyRT）
// 每像素：uv → 球面方向（FMDS skylutdir 投影）→ GetSkyRadiance（Bruneton LUT 查询，零积分）
// → 线性 HDR → RGBA16F（避免 LogLuv32 编解码在天空渐变中的量化条纹）
#include "atmo_common.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0, rgba16f) uniform writeonly image2D skyRT;
layout(set = 0, binding = 1) uniform sampler2D transmittanceLUT;
layout(set = 0, binding = 2) uniform sampler3D scatteringLUT;

layout(push_constant) uniform PC {
    vec4 sunDir;    // .xyz = 太阳方向（世界，单位向量）
    ivec2 skySize;  // 全景图分辨率
    float altitudeMeters;
    vec4 lightColor;  // 尾插（ABI 纪律）：.rgb = 场景平行光 颜色×强度（滑条旋钮；天空辐射度随之缩放）
} pc;

// ================= 全景天空图投影（FMDS sky.inc skylutdir 移植，米制） =================
// 与 fullscreen.frag 的 skylutuv 互为逆（同一 CAM_ALT=0.2、EARTH_R 球面投影 + pow4 扭曲）
float linstep(float edge0, float edge1, float x) {
    return clamp((x - edge0) / (edge1 - edge0), 0.0, 1.0);
}
vec3 skylutdir(vec2 uv, float altitudeMeters) {
    const float EARTH_R = 6371000.0;
    float r = EARTH_R + max(altitudeMeters, 0.0);
    float r2 = r * r;

    float s = EARTH_R / r;
    float y = -sqrt(1.0 - s * s);
    float t = clamp(y * 0.5 + 0.5, 0.0, 1.0);

    float x = mix(linstep(t, 1.0, uv.y), linstep(t, 0.0, uv.y), float(uv.y < t));
    float expo = mix(4.0, 1.0, clamp(altitudeMeters / 60000.0, 0.0, 1.0));
    x = pow(x, expo);

    float azimuthAngle = uv.x * 2.0 * PI;
    float adjV = mix((x * (1.0 - t) + t), (-x * t + t), float(uv.y < t)) * 2.0 - 1.0;

    float horizonAngle = acos(clamp(sqrt(r2 - EARTH_R * EARTH_R) / r, -1.0, 1.0)) - 0.5 * PI;
    float altitudeAngle = adjV * 0.5 * PI - horizonAngle;

    float cosAltitude = cos(altitudeAngle);
    return vec3(cosAltitude * sin(azimuthAngle), sin(altitudeAngle), cosAltitude * cos(azimuthAngle));
}

void main() {
    ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    if (px.x >= pc.skySize.x || px.y >= pc.skySize.y) return;

    // cubemap 改走独立着色器（atmo_sky_cube.comp——并行 IBL/反射设施）
    vec2 uv = (vec2(px) + 0.5) / vec2(pc.skySize);
    vec3 view = skylutdir(uv, pc.altitudeMeters);
    vec3 skyView = view;
    float depthFade = 1.0;
    if (view.y < 0.0) {
        skyView.y = 0.0;
        depthFade = exp(-max(-view.y, 0.0) * 3.0);
    }
    // 地表相机（海拔实时输入：pc.altitudeMeters——用户约定 max(0, 相机y+200)，默认 200m）
    // ⚠️ 与 fullscreen.frag skylutuv 的 CAM_ALT 必须同值（否则生成/采样地平线映射错位）
    vec3 campos = vec3(0.0, BOTTOM_RADIUS + max(pc.altitudeMeters, 0.0), 0.0);
    vec3 sun = normalize(pc.sunDir.xyz);

    // demo.js 无 nightGlow，夜晚为纯物理散射（sun 低于地平线 → 天空接近黑）；
    // 原 nightGlow（深蓝微光）已移除——如需月夜可见度，可加"物理月光散射（moon 方向调 GetSkyRadiance）"或按 demo 预设提高曝光
    // 去掉地平线雾（skyView 钳地平线 + depthFade + fogBright）与月光散射（A/B 对比时发现多余）；
    // nightFade 保留（夜晚天空变暗——白天=0 不影响对比）；地平线下=真实视线（撞地球散射，同 per-pixel）
    vec3 transmittance;
    vec3 color = GetSkyRadiance(transmittanceLUT, scatteringLUT, campos, skyView, 0.0, sun, transmittance)*depthFade;
    float nightFade = 1.0 - smoothstep(-0.5, -0.1, sun.y);
    vec3 moonDir = -sun;
    vec3 moonTransmittance;
    vec3 moonColor = GetSkyRadiance(transmittanceLUT, scatteringLUT, campos, skyView, 0.0, moonDir, moonTransmittance)*depthFade;
    color += moonColor * (0.01+0.01*nightFade);  
    // ===== 场景曝光 + 场景平行光（skyRT 生产端定标）=====
    // pc.sunDir.w = C++ kSceneExposure：物理辐射度 → 显示参考 HDR。
    // pc.lightColor.rgb = 场景平行光(颜色×强度)：**天空亮度跟随滑条**的施加点——
    // 全景天空和重投影采样端直接读取线性颜色；这里统一乘曝光和场景平行光，tonemap 端按 sunDir.w 反向归一化。
    // 注意：depthFade/月光项都已含在 color 内，故只在写入 RGBA16F 前乘。
    vec3 linearHdr = color * pc.sunDir.w * pc.lightColor.rgb;
    imageStore(skyRT, px, vec4(max(linearHdr, vec3(0.0)), 1.0));
}
